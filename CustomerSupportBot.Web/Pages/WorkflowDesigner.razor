@page "/workflow-designer"
@attribute [Authorize]
@layout AdminLayout
@inject WorkflowApiService WorkflowApi

<link rel="stylesheet" href="css/workflow.css" />

<div class="wf-container">
    <h1>🔧 Workflow Designer</h1>
    <p class="muted">Low-code workflow tanımları (admin). LLM-siz, deterministik, mevcut tool'ları (yan etkisiz olanlar) zincirler.</p>

    @if (!string.IsNullOrEmpty(_errorMsg))
    {
        <div style="color:#dc2626;margin-bottom:8px;">⚠ @_errorMsg</div>
    }

    <div class="layout">
        <!-- LEFT: list + actions -->
        <div class="panel">
            <h3>Workflow'lar</h3>
            <button class="primary" @onclick="NewWorkflow">+ Yeni</button>
            <button @onclick="LoadListAsync">Yenile</button>
            <div class="row--mt12">
                @if (_list.Count == 0)
                {
                    <p class="muted">Henüz workflow yok.</p>
                }
                else
                {
                    @foreach (var item in _list)
                    {
                        <div class="list-item @(_currentId == item.Id ? "active" : "")"
                             @onclick="() => LoadDefAsync(item.Id)"
                             role="button" tabindex="0">
                            <strong>@item.Name</strong>
                            <span class="badge @(item.IsActive ? "active" : "inactive")">
                                @(item.IsActive ? "aktif" : "pasif")
                            </span>
                            <div class="muted">@item.Id · v@item.Version · @item.StepCount adım</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- RIGHT: editor + tester -->
        <div class="panel">
            <h3>Tanım (JSON)</h3>
            <p class="muted">
                Adım tipleri: <code>Respond</code> (template), <code>Lookup</code> (tool çağrı),
                <code>Branch</code> (koşul), <code>SetVariable</code>. Yan etkili tool'lar izin verilmez.
            </p>
            <textarea rows="22" aria-label="Workflow JSON tanımı" placeholder="Workflow JSON tanımı…"
                      @bind="_editorJson" @bind:event="oninput"></textarea>

            <div class="row row--mt12">
                <button class="primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Kaydediliyor…" : "💾 Kaydet")
                </button>
                <button class="danger" @onclick="DeleteAsync" disabled="@(_currentId is null)">🗑️ Sil</button>
                <span class="muted">@_meta</span>
            </div>

            <hr />

            <h3>Test Çalıştır</h3>
            <div class="row">
                <label>User input:</label>
                <input type="text" class="input--flex" placeholder="ör. ORD-1 durumu nedir"
                       @bind="_testInput" @bind:event="oninput" />
                <button @onclick="RunTestAsync" disabled="@(_currentId is null)">▶ Test</button>
            </div>
            <pre>@_testResult</pre>
        </div>
    </div>
</div>

@code {
    private List<WorkflowListEntry> _list = [];
    private string?  _currentId;
    private string   _editorJson = string.Empty;
    private string   _meta       = string.Empty;
    private string   _testInput  = string.Empty;
    private string   _testResult = "// sonuçlar burada";
    private bool     _saving;
    private string?  _errorMsg;


    protected override async Task OnInitializedAsync() => await LoadListAsync();

    private async Task LoadListAsync()
    {
        _errorMsg = null;
        _list = await WorkflowApi.GetListAsync();
    }

    private async Task LoadDefAsync(string id)
    {
        var raw = await WorkflowApi.GetRawAsync(id);
        if (raw is null) { _errorMsg = $"Workflow yüklenemedi: {id}"; return; }
        _currentId  = id;
        _editorJson = raw;
        _meta       = $"id: {id}";
        _errorMsg   = null;
    }

    private void NewWorkflow()
    {
        _currentId  = null;
        _editorJson = WorkflowDefaults.SampleJson;
        _meta       = string.Empty;
        _errorMsg   = null;
    }

    private async Task SaveAsync()
    {
        _errorMsg = null;
        _saving   = true;
        var (ok, err, savedId) = await WorkflowApi.SaveAsync(_currentId, _editorJson);
        _saving = false;
        if (!ok) { _errorMsg = err; return; }
        _currentId = savedId;
        _meta      = $"id: {savedId}";
        await LoadListAsync();
        if (savedId is not null) await LoadDefAsync(savedId);
    }

    private async Task DeleteAsync()
    {
        if (_currentId is null) return;
        var (ok, err) = await WorkflowApi.DeleteAsync(_currentId);
        if (!ok) { _errorMsg = err; return; }
        _currentId  = null;
        _editorJson = string.Empty;
        _meta       = string.Empty;
        await LoadListAsync();
    }

    private async Task RunTestAsync()
    {
        if (_currentId is null) return;
        _testResult = "Çalıştırılıyor…";
        _testResult = await WorkflowApi.TestAsync(_currentId, _testInput);
    }
}
