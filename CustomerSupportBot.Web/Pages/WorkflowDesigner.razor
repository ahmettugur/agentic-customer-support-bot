@page "/workflow-designer"
@layout EmptyLayout
@inject IJSRuntime JS

<link rel="stylesheet" href="css/admin.css" />
<style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f9fafb; }
    .wf-container { padding: 20px; max-width: 1200px; margin: 0 auto; }
    .layout { display: grid; grid-template-columns: 320px 1fr; gap: 16px; margin-top: 16px; }
    .row--mt12 { margin-top: 12px; }
    .input--flex { flex: 1; padding: 6px; }
    .panel { border: 1px solid #ddd; border-radius: 6px; padding: 12px; background: #fafafa; }
    textarea { width: 100%; font-family: 'Consolas', monospace; font-size: 12px; border: 1px solid #ccc; border-radius: 4px; padding: 8px; }
    .row { display: flex; gap: 8px; align-items: center; margin: 6px 0; }
    .row > label { min-width: 100px; }
    button { padding: 6px 14px; cursor: pointer; border: 1px solid #888; background: #fff; border-radius: 4px; }
    button.primary { background: #2563eb; color: #fff; border-color: #2563eb; }
    button.danger { background: #dc2626; color: #fff; border-color: #dc2626; }
    .list-item { padding: 8px; border: 1px solid #ddd; margin: 4px 0; border-radius: 4px; cursor: pointer; }
    .list-item:hover { background: #eef; }
    .list-item.active { background: #dbeafe; border-color: #2563eb; }
    .badge { display: inline-block; padding: 2px 6px; border-radius: 10px; font-size: 11px; background: #e5e7eb; }
    .badge.active { background: #d1fae5; color: #065f46; }
    .badge.inactive { background: #fee2e2; color: #991b1b; }
    pre { background: #f3f4f6; padding: 8px; border-radius: 4px; max-height: 320px; overflow: auto; font-size: 12px; }
    h2, h3 { margin: 8px 0; }
    .muted { color: #666; font-size: 12px; }
</style>

<div class="wf-container">
    <h1>🔧 Workflow Designer</h1>
    <p class="muted">Low-code workflow tanımları (admin). LLM-siz, deterministik, mevcut tool'ları (yan etkisiz olanlar) zincirler.</p>

    <div class="layout">
        <!-- LEFT: list + actions -->
        <div class="panel">
            <h3>Workflow'lar</h3>
            <button id="newBtn" class="primary">+ Yeni</button>
            <button id="reloadBtn">Yenile</button>
            <div id="list" class="row--mt12"></div>
        </div>

        <!-- RIGHT: editor + tester -->
        <div class="panel">
            <h3>Tanım (JSON)</h3>
            <p class="muted">
                Adım tipleri: <code>Respond</code> (template), <code>Lookup</code> (tool çağrı),
                <code>Branch</code> (koşul), <code>SetVariable</code>. Yan etkili tool'lar (sipariş/şikayet) izin verilmez.
            </p>
            <textarea id="editor" rows="22" aria-label="Workflow JSON tanımı" placeholder="Workflow JSON tanımı…"></textarea>

            <div class="row row--mt12">
                <button id="saveBtn" class="primary">💾 Kaydet</button>
                <button id="deleteBtn" class="danger">🗑️ Sil</button>
                <span class="muted" id="meta"></span>
            </div>

            <hr />

            <h3>Test Çalıştır</h3>
            <div class="row">
                <label>User input:</label>
                <input id="testInput" type="text" class="input--flex" placeholder="ör. ORD-1 durumu nedir" />
                <button id="testBtn">▶ Test</button>
            </div>
            <pre id="testResult">// sonuçlar burada</pre>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("loadScript", "/js/auth.js", "js-auth");
            await JS.InvokeVoidAsync("eval", "window.Auth.requireAuth()");
            await JS.InvokeVoidAsync("loadScript", "/js/admin-nav.js", "js-admin-nav");
            await JS.InvokeVoidAsync("loadScript", "/js/workflow-designer.js", "js-workflow-designer");
        }
    }
}
