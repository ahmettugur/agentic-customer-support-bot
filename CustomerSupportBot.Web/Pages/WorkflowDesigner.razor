@page "/workflow-designer"
@attribute [Authorize]
@layout AdminLayout
@inject WorkflowApiService WorkflowApi
@inject IJSRuntime JS
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization

<link rel="stylesheet" href="css/workflow.css" />
<link rel="stylesheet" href="css/x6.css" />

<div class="wfd-shell">

    <!-- ═══════════════ SOL PANEL — Workflow listesi ═══════════════ -->
    <aside class="wfd-sidebar">
        <div class="wfd-sidebar-header">
            <h3 class="wfd-sidebar-title">Workflow'lar</h3>
            <button class="wfd-btn wfd-btn-primary wfd-btn-sm" @onclick="NewWorkflow" title="Yeni workflow oluştur">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Yeni
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="wfd-error-bar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @_errorMsg
            </div>
        }

        <div class="wfd-list">
            @if (_list.Count == 0)
            {
                <p class="wfd-list-empty">Henüz workflow yok.</p>
            }
            else
            {
                @foreach (var item in _list)
                {
                    <button class="wfd-list-item @(_currentId == item.Id ? "active" : "")"
                            @onclick="() => LoadDefAsync(item.Id)">
                        <div class="wfd-list-item-name">@item.Name</div>
                        <div class="wfd-list-item-meta">
                            <span class="wfd-badge @(item.IsActive ? "active" : "inactive")">
                                @(item.IsActive ? "Aktif" : "Pasif")
                            </span>
                            <span class="wfd-list-item-steps">@item.StepCount adım</span>
                        </div>
                    </button>
                }
            }
        </div>

        <button class="wfd-refresh-btn" @onclick="LoadListAsync">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Yenile
        </button>
    </aside>

    <!-- ═══════════════ ANA ALAN ═══════════════════════════════════ -->
    <main class="wfd-main">

        <!-- Üst toolbar -->
        <header class="wfd-toolbar">
            <!-- Adım palette -->
            <div class="wfd-palette">
                <span class="wfd-palette-label">Adım ekle:</span>
                <button class="wfd-step-btn respond"     @onclick='() => AddStepAsync("Respond")'>     ▶ Yanıt</button>
                <button class="wfd-step-btn lookup"      @onclick='() => AddStepAsync("Lookup")'>      ⚡ Sorgula</button>
                <button class="wfd-step-btn branch"      @onclick='() => AddStepAsync("Branch")'>      ⑃ Koşul</button>
                <button class="wfd-step-btn setvariable" @onclick='() => AddStepAsync("SetVariable")'> ✎ Değişken</button>
            </div>

            <div class="wfd-toolbar-sep"></div>

            <!-- History -->
            <div class="wfd-toolbar-group">
                <button class="wfd-icon-btn" @onclick="UndoAsync"          title="Geri Al">↩</button>
                <button class="wfd-icon-btn" @onclick="RedoAsync"          title="Yinele">↪</button>
                <button class="wfd-icon-btn wfd-del-icon" @onclick="DeleteSelectedAsync" title="Seçileni Sil">✕</button>
            </div>

            <div class="wfd-toolbar-sep"></div>

            <!-- Zoom -->
            <div class="wfd-toolbar-group">
                <button class="wfd-icon-btn" @onclick="ZoomInAsync"  title="Yakınlaş">＋</button>
                <button class="wfd-icon-btn" @onclick="ZoomOutAsync" title="Uzaklaş">－</button>
                <button class="wfd-icon-btn" @onclick="ZoomFitAsync" title="Ekrana Sığdır">⊡</button>
            </div>

            <div class="wfd-toolbar-sep"></div>

            <!-- Kaydet / Sil -->
            <div class="wfd-toolbar-group">
                <button class="wfd-btn wfd-btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Kaydediliyor…" : "💾 Kaydet")
                </button>
                <button class="wfd-btn wfd-btn-danger" @onclick="DeleteWorkflowAsync" disabled="@(_currentId is null)">
                    🗑 Sil
                </button>
            </div>

            @if (_meta is not null)
            {
                <span class="wfd-meta">@_meta</span>
            }
        </header>

        <!-- Kanvas alanı -->
        <div class="wfd-canvas-wrap">
            @if (_currentId is null && !_isNew)
            {
                <div class="wfd-canvas-empty">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
                    <p>Sol panelden bir workflow seçin veya <strong>+ Yeni</strong>'ye tıklayın.</p>
                </div>
            }
            @if (_currentId is not null || _isNew)
            {
                <!-- Bağlantı kılavuzu — sağ alt köşe -->
                <div class="wfd-hint-box">
                    <div class="wfd-hint-row">
                        <span class="wfd-hint-dot out"></span>
                        <span>Çıkış portuna <strong>tıkla ve sürükle</strong> → hedef kutunun giriş portuna bırak</span>
                    </div>
                    <div class="wfd-hint-row">
                        <span class="wfd-hint-dot in"></span>
                        <span>Gri = Giriş &nbsp;|&nbsp; Renkli = Çıkış</span>
                    </div>
                    <div class="wfd-hint-row">
                        <span class="wfd-hint-icon">⊡</span>
                        <span>Kaydırmak için <strong>sağ tık + sürükle</strong>, zoom için <strong>tekerlek</strong></span>
                    </div>
                </div>
            }
            <div id="wf-canvas" class="wfd-canvas @((_currentId is null && !_isNew) ? "hidden" : "")"></div>
        </div>
    </main>

    <!-- ═══════════════ SAĞ PANEL — Properties + Test ══════════════ -->
    <aside class="wfd-props-panel">

        <!-- Workflow meta bilgileri -->
        @if (_currentId is not null || _isNew)
        {
            <section class="wfd-props-section wfd-meta-form">
                <h4 class="wfd-props-section-title">Workflow Bilgileri</h4>
                <label class="wfd-field-label">Ad</label>
                <input class="wfd-field-input" @bind="_wfName" placeholder="Workflow adı" />

                <label class="wfd-field-label">Açıklama</label>
                <textarea class="wfd-field-textarea" rows="2" @bind="_wfDesc" placeholder="Kısa açıklama"></textarea>

                <label class="wfd-field-label">Tetikleyici Kelimeler</label>
                <input class="wfd-field-input" @bind="_wfKeywords"
                       placeholder="virgülle ayırın: sipariş, kargo" />

                <div class="wfd-field-check">
                    <input type="checkbox" id="wf-active" @bind="_wfIsActive" />
                    <label for="wf-active">Aktif</label>
                </div>
            </section>
        }

        <!-- Seçili node özellikleri -->
        @if (_selectedStep is not null)
        {
            <section class="wfd-props-section">
                <h4 class="wfd-props-section-title">Adım Özellikleri</h4>

                <label class="wfd-field-label">Etiket (opsiyonel)</label>
                <input class="wfd-field-input"
                       @bind="_selectedStep.Label" @bind:event="oninput" @bind:after="OnPropChanged"
                       placeholder="Adım adı" />

                @switch (_selectedStep.Type)
                {
                    case "Respond":
                        <label class="wfd-field-label">Şablon Mesaj</label>
                        <textarea class="wfd-field-textarea" rows="4"
                                  @bind="_selectedStep.Template" @bind:event="oninput" @bind:after="OnPropChanged"
                                  placeholder="Merhaba {input}! Sipariş #{orderId} durumu: {siparis}"></textarea>
                        <p class="wfd-field-hint">Değişkenler: <code>{input}</code>, <code>{orderId}</code>, vb.</p>
                        break;

                    case "Lookup":
                        <label class="wfd-field-label">Tool</label>
                        <select class="wfd-field-select" @bind="_selectedStep.Tool" @bind:after="OnPropChanged">
                            <option value="">— Seçin —</option>
                            @foreach (var t in _toolOptions)
                            {
                                <option value="@t.Value">@t.Label</option>
                            }
                        </select>

                        <label class="wfd-field-label">Parametreler</label>
                        @for (int i = 0; i < _selectedStep.Parameters.Count; i++)
                        {
                            var idx = i;
                            <div class="wfd-param-row">
                                <input class="wfd-field-input wfd-param-key"
                                       value="@_selectedStep.Parameters[idx].Key"
                                       @oninput="e => UpdateParamKey(idx, e.Value?.ToString())"
                                       placeholder="key" />
                                <input class="wfd-field-input wfd-param-val"
                                       value="@_selectedStep.Parameters[idx].Value"
                                       @oninput="e => UpdateParamValue(idx, e.Value?.ToString())"
                                       placeholder="$orderId" />
                                <button class="wfd-icon-btn wfd-param-del" @onclick="() => RemoveParam(idx)">×</button>
                            </div>
                        }
                        <button class="wfd-btn wfd-btn-ghost wfd-btn-sm" @onclick="AddParam">+ Parametre</button>

                        <label class="wfd-field-label wfd-mt">Sonucu kaydet (storeAs)</label>
                        <input class="wfd-field-input"
                               @bind="_selectedStep.StoreAs" @bind:event="oninput" @bind:after="OnPropChanged"
                               placeholder="siparis" />
                        <p class="wfd-field-hint">Değişkenler: <code>{siparis}</code>, <code>{siparis.success}</code>, <code>{siparis.message}</code></p>
                        break;

                    case "Branch":
                        <label class="wfd-field-label">Koşul</label>
                        <input class="wfd-field-input"
                               @bind="_selectedStep.Condition" @bind:event="oninput" @bind:after="OnPropChanged"
                               placeholder="orderId exists" />
                        <p class="wfd-field-hint">
                            <code>varName exists</code> · <code>varName missing</code> ·
                            <code>varName == value</code> · <code>varName != value</code>
                        </p>
                        <div class="wfd-branch-info">
                            <span class="wfd-branch-true">Doğru →</span> sağdaki bağlantı
                            <br/>
                            <span class="wfd-branch-false">Yanlış →</span> alttaki bağlantı
                        </div>
                        break;

                    case "SetVariable":
                        <label class="wfd-field-label">Değişken Adı</label>
                        <input class="wfd-field-input"
                               @bind="_selectedStep.VariableName" @bind:event="oninput" @bind:after="OnPropChanged"
                               placeholder="query" />

                        <label class="wfd-field-label">Değer (şablon)</label>
                        <input class="wfd-field-input"
                               @bind="_selectedStep.VariableValue" @bind:event="oninput" @bind:after="OnPropChanged"
                               placeholder="{input}" />
                        break;
                }

                <div class="wfd-props-node-id">ID: <code>@_selectedStep.NodeId</code></div>
            </section>
        }

        <!-- Test Runner -->
        @if (_currentId is not null)
        {
            <section class="wfd-props-section">
                <h4 class="wfd-props-section-title">Test Çalıştır</h4>
                <label class="wfd-field-label">Kullanıcı girdisi</label>
                <input class="wfd-field-input" @bind="_testInput" placeholder="sipariş 1030 durumu nedir" />
                <button class="wfd-btn wfd-btn-primary wfd-btn-sm wfd-mt"
                        @onclick="RunTestAsync" disabled="@_testing">
                    @(_testing ? "Çalışıyor…" : "▶ Test")
                </button>
                @if (_testResult is not null)
                {
                    <pre class="wfd-test-result">@_testResult</pre>
                }
            </section>
        }
    </aside>
</div>

@code {
    // ── State ────────────────────────────────────────────────────────────────
    private List<WorkflowListEntry> _list   = [];
    private string?  _currentId;
    private bool     _isNew;
    private string   _wfName     = "";
    private string   _wfDesc     = "";
    private string   _wfKeywords = "";
    private bool     _wfIsActive = true;
    private string?  _meta;
    private bool     _saving;
    private bool     _testing;
    private string?  _testInput;
    private string?  _testResult;
    private string?  _errorMsg;

    private StepPropsModel?           _selectedStep;
    private List<ToolOption>          _toolOptions = [];
    private DotNetObjectReference<WorkflowDesigner>? _dotNetRef;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotNetRef = DotNetObjectReference.Create(this);

        // x6.js: sabit (büyük lib, cache'de kalsın)
        // workflow-x6.js: her render'da taze yükle (geliştirme kolaylığı)
        var wfV = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        await JS.InvokeVoidAsync("loadScript", "/js/x6.js", "js-x6");
        await JS.InvokeVoidAsync("loadScript", $"/js/workflow-x6.js?v={wfV}", "js-wf-x6");
        await JS.InvokeVoidAsync("wfDesigner.init", "wf-canvas", _dotNetRef);

        // Tool seçeneklerini JS'den al
        var toolJson = await JS.InvokeAsync<string>("wfDesigner.getToolOptions");
        _toolOptions = JsonSerializer.Deserialize<List<ToolOption>>(toolJson,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];

        StateHasChanged();
    }

    // ── JS Callbacks ─────────────────────────────────────────────────────────
    [JSInvokable]
    public void OnNodeSelected(string? dataJson)
    {
        if (dataJson is null)
        {
            _selectedStep = null;
        }
        else
        {
            try
            {
                var raw = JsonSerializer.Deserialize<JsonElement>(dataJson);
                _selectedStep = StepPropsModel.FromJson(raw);
            }
            catch { _selectedStep = null; }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnGraphChanged(string? _) => StateHasChanged();

    // ── Workflow list ────────────────────────────────────────────────────────
    private async Task LoadListAsync()
    {
        _errorMsg = null;
        _list     = await WorkflowApi.GetListAsync();
    }

    private async Task LoadDefAsync(string id)
    {
        _errorMsg     = null;
        _selectedStep = null;
        _testResult   = null;
        _isNew        = false;

        var raw = await WorkflowApi.GetRawAsync(id);
        if (raw is null) { _errorMsg = $"Workflow yüklenemedi: {id}"; return; }

        _currentId = id;

        try
        {
            using var doc   = JsonDocument.Parse(raw);
            var root        = doc.RootElement;
            _wfName         = root.TryGetProp("name")        ?? "";
            _wfDesc         = root.TryGetProp("description") ?? "";
            _wfIsActive     = root.TryGetBool("isActive")    ?? true;
            _wfKeywords     = string.Join(", ",
                root.TryGetStringArray("triggerKeywords") ?? []);
            var updatedAt   = root.TryGetProp("updatedAt");
            var version     = root.TryGetInt("version");
            var updatedBy   = root.TryGetProp("updatedBy");
            _meta = updatedAt is not null
                ? $"v{version} · {updatedAt}{(updatedBy is not null ? " · " + updatedBy : "")}"
                : $"id: {id}";
        }
        catch { _meta = $"id: {id}"; }

        await JS.InvokeVoidAsync("wfDesigner.loadGraph", raw);
    }

    private void NewWorkflow()
    {
        _currentId    = null;
        _isNew        = true;
        _selectedStep = null;
        _testResult   = null;
        _wfName       = "Yeni Workflow";
        _wfDesc       = "";
        _wfKeywords   = "";
        _wfIsActive   = true;
        _meta         = null;
        _errorMsg     = null;

        // Boş bir canvas aç
        _ = JS.InvokeVoidAsync("wfDesigner.loadGraph", "{\"steps\":[]}");
    }

    // ── Save ─────────────────────────────────────────────────────────────────
    private async Task SaveAsync()
    {
        _errorMsg = null;
        _saving   = true;
        StateHasChanged();

        try
        {
            // X6'dan graph verisini al
            var graphJson = await JS.InvokeAsync<string>("wfDesigner.getGraphData");
            using var graphDoc = JsonDocument.Parse(graphJson);

            var keywords = _wfKeywords
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            // steps dizisini ve startStepId'yi birleştir
            var steps      = graphDoc.RootElement.TryGetProperty("steps",      out var stepsEl)
                ? stepsEl : (JsonElement?)null;
            var startStepId = graphDoc.RootElement.TryGetProperty("startStepId", out var ssEl)
                ? ssEl.GetString() : null;

            // Mevcut workflow'un inputPatterns'ini koru
            Dictionary<string, string>? inputPatterns = null;
            if (_currentId is not null)
            {
                var existingRaw = await WorkflowApi.GetRawAsync(_currentId);
                if (existingRaw is not null)
                {
                    using var existingDoc = JsonDocument.Parse(existingRaw);
                    if (existingDoc.RootElement.TryGetProperty("inputPatterns", out var ip))
                    {
                        inputPatterns = JsonSerializer.Deserialize<Dictionary<string, string>>(ip.GetRawText());
                    }
                }
            }

            var requestBody = new
            {
                name            = _wfName,
                description     = _wfDesc,
                isActive        = _wfIsActive,
                startStepId,
                triggerKeywords = keywords,
                inputPatterns   = inputPatterns ?? new Dictionary<string, string>(),
                steps           = steps.HasValue
                    ? JsonSerializer.Deserialize<object>(steps.Value.GetRawText())
                    : Array.Empty<object>()
            };

            var bodyJson = JsonSerializer.Serialize(requestBody);
            var (ok, err, savedId) = await WorkflowApi.SaveAsync(_currentId, bodyJson);

            if (!ok) { _errorMsg = err; return; }

            _currentId = savedId;
            _isNew     = false;
            _meta      = $"id: {savedId}";
            await LoadListAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteWorkflowAsync()
    {
        if (_currentId is null) return;
        var (ok, err) = await WorkflowApi.DeleteAsync(_currentId);
        if (!ok) { _errorMsg = err; return; }
        _currentId    = null;
        _isNew        = false;
        _selectedStep = null;
        _meta         = null;
        await LoadListAsync();
        await JS.InvokeVoidAsync("wfDesigner.loadGraph", "{\"steps\":[]}");
    }

    // ── Test ─────────────────────────────────────────────────────────────────
    private async Task RunTestAsync()
    {
        if (_currentId is null) return;
        _testing    = true;
        _testResult = "Çalışıyor…";
        StateHasChanged();
        _testResult = await WorkflowApi.TestAsync(_currentId, _testInput ?? "");
        _testing    = false;
    }

    // ── Canvas komutları ─────────────────────────────────────────────────────
    private async Task AddStepAsync(string type) =>
        await JS.InvokeVoidAsync("wfDesigner.addStep", type);
    private async Task UndoAsync()          => await JS.InvokeVoidAsync("wfDesigner.undo");
    private async Task RedoAsync()          => await JS.InvokeVoidAsync("wfDesigner.redo");
    private async Task ZoomInAsync()        => await JS.InvokeVoidAsync("wfDesigner.zoomIn");
    private async Task ZoomOutAsync()       => await JS.InvokeVoidAsync("wfDesigner.zoomOut");
    private async Task ZoomFitAsync()       => await JS.InvokeVoidAsync("wfDesigner.zoomFit");
    private async Task DeleteSelectedAsync()=> await JS.InvokeVoidAsync("wfDesigner.deleteSelected");

    // ── Properties panel ────────────────────────────────────────────────────
    private async Task OnPropChanged()
    {
        if (_selectedStep is null) return;
        var json = _selectedStep.ToJson();
        await JS.InvokeVoidAsync("wfDesigner.updateSelectedNode", json);
    }

    private void AddParam()
    {
        _selectedStep?.Parameters.Add(new ParamEntry("", ""));
    }

    private void RemoveParam(int idx)
    {
        _selectedStep?.Parameters.RemoveAt(idx);
        _ = OnPropChanged();
    }

    private void UpdateParamKey(int idx, string? key)
    {
        if (_selectedStep is null || idx >= _selectedStep.Parameters.Count) return;
        _selectedStep.Parameters[idx] = new ParamEntry(key ?? "", _selectedStep.Parameters[idx].Value);
        _ = OnPropChanged();
    }

    private void UpdateParamValue(int idx, string? value)
    {
        if (_selectedStep is null || idx >= _selectedStep.Parameters.Count) return;
        _selectedStep.Parameters[idx] = new ParamEntry(_selectedStep.Parameters[idx].Key, value ?? "");
        _ = OnPropChanged();
    }

    // ── Dispose ──────────────────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("wfDesigner.destroy"); } catch { }
        _dotNetRef?.Dispose();
    }

    // ── Inner models ─────────────────────────────────────────────────────────
    private sealed class StepPropsModel
    {
        public string  NodeId        { get; set; } = "";
        public string  Type          { get; set; } = "Respond";
        public string? Label         { get; set; }
        public string? Template      { get; set; }
        public string? Tool          { get; set; }
        public string? StoreAs       { get; set; }
        public string? Condition     { get; set; }
        public string? VariableName  { get; set; }
        public string? VariableValue { get; set; }
        public List<ParamEntry> Parameters { get; set; } = [];

        public static StepPropsModel FromJson(JsonElement el)
        {
            static string? S(JsonElement e, string k) =>
                e.TryGetProperty(k, out var p) ? p.GetString() : null;

            var model = new StepPropsModel
            {
                NodeId        = S(el, "id")            ?? S(el, "nodeId") ?? "",
                Type          = S(el, "type")           ?? "Respond",
                Label         = S(el, "label"),
                Template      = S(el, "template"),
                Tool          = S(el, "tool"),
                StoreAs       = S(el, "storeAs"),
                Condition     = S(el, "condition"),
                VariableName  = S(el, "variableName"),
                VariableValue = S(el, "variableValue")
            };

            if (el.TryGetProperty("parameters", out var pm) && pm.ValueKind == JsonValueKind.Object)
            {
                foreach (var prop in pm.EnumerateObject())
                    model.Parameters.Add(new ParamEntry(prop.Name, prop.Value.GetString() ?? ""));
            }

            return model;
        }

        public string ToJson()
        {
            var dict = new Dictionary<string, object?>
            {
                ["id"]            = NodeId,
                ["type"]          = Type,
                ["label"]         = Label,
                ["template"]      = Template,
                ["tool"]          = Tool,
                ["storeAs"]       = StoreAs,
                ["condition"]     = Condition,
                ["variableName"]  = VariableName,
                ["variableValue"] = VariableValue,
                ["parameters"]    = Parameters.ToDictionary(p => p.Key, p => (object?)p.Value)
            };
            return JsonSerializer.Serialize(dict);
        }
    }

    private sealed record ParamEntry(string Key, string Value);

    private sealed class ToolOption
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }
}
