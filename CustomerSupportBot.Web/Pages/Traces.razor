@page "/traces"
@layout EmptyLayout
@inject IJSRuntime JS

<link rel="stylesheet" href="css/traces.css" />

<div class="traces-layout">

    <!-- HEADER -->
    <header class="traces-header">
        <div class="traces-header-left">
            <a href="/" class="btn-icon" title="Sohbete dön">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </a>
            <div class="traces-header-info">
                <h1>Reasoning Trace Dashboard</h1>
                <p class="muted">Session bazlı düşünme zinciri takibi</p>
            </div>
        </div>
        <div class="traces-header-right">
            <label class="auto-refresh-toggle" title="Aktif iken liste 5 saniyede bir yenilenir">
                <input type="checkbox" id="autoRefreshToggle" checked />
                <span>Auto-refresh (5sn)</span>
            </label>
            <button class="btn-secondary" id="refreshBtn" title="Yenile">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                    <path d="M21 3v5h-5"/>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                    <path d="M3 21v-5h5"/>
                </svg>
                Yenile
            </button>
        </div>
    </header>

    <div class="traces-main">
        <!-- LEFT — SESSION LIST -->
        <aside class="traces-sessions-pane" id="sessionsPane">
            <div class="traces-sessions-header">
                <div class="traces-sessions-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/>
                    </svg>
                    <span>Oturumlar</span>
                    <span class="traces-session-count" id="sessionCount">0</span>
                </div>
                <button class="btn-all-traces" id="showAllTracesBtn" title="Tüm trace'leri göster">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
                    </svg>
                    Tümü
                </button>
            </div>
            <div class="traces-sessions-list" id="sessionsList">
                <div class="traces-empty">Henüz oturum yok</div>
            </div>
        </aside>

        <!-- CENTER — TRACE LIST -->
        <aside class="traces-list-pane">
            <div class="traces-list-header">
                <span id="tracesCount" class="traces-count">—</span>
                <span class="muted" id="tracesLabel">trace</span>
            </div>
            <div class="traces-list" id="tracesList">
                <div class="traces-empty">Bir oturum seçin veya Tümü butonuna tıklayın</div>
            </div>
        </aside>

        <!-- RIGHT — TRACE DETAIL -->
        <main class="trace-detail-pane" id="traceDetailPane">
            <div class="trace-detail-empty">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.3">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                    <path d="M12 17h.01"/>
                </svg>
                <p class="muted">Bir trace seçin</p>
            </div>
        </main>
    </div>

</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("loadScript", "/js/auth.js", "js-auth");
            await JS.InvokeVoidAsync("eval", "window.Auth.requireAuth()");
            await JS.InvokeVoidAsync("loadScript", "/js/traces.js", "js-traces");
        }
    }
}
