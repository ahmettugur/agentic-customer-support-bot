@page "/sla"
@attribute [Authorize]
@layout AdminLayout
@inject SlaApiService SlaApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<link rel="stylesheet" href="css/sla.css" />

<div class="sla-container">
    <div class="sla-toolbar">
        <h1>⏱️ SLA Guardian</h1>
        <div>
            @{
                var pillClass = _status?.Enabled == true ? "ok" : "off";
                var pillText  = _status is { Enabled: true }
                    ? $"aktif · {_status.PollIntervalSeconds}sn"
                    : (_status is null ? "durum bilinmiyor" : "pasif");
            }
            <span class="pill @pillClass">@pillText</span>
            <button @onclick="RefreshAsync" style="margin-left:8px;">Yenile</button>
            <label style="margin-left:8px; font-size:12px; color:#4b5563;">
                <input type="checkbox" @bind="_autoRefresh" @bind:after="OnAutoRefreshChanged" /> Auto (5sn)
            </label>
        </div>
    </div>
    <p class="muted">Bekleyen onayları ve açık eskalasyonları periyodik tarayan arka plan servisi.
       Eşik aşan onaylar otomatik reddedilir; eskalasyonların önceliği yükseltilir.</p>

    <div class="sla-grid">
        <div class="sla-card">
            <h3>📋 Onay Kuyruğu</h3>
            @if (_status?.Approvals is { } a)
            {
                @StatRow("Bekleyen sayı",     a.PendingCount.ToString(),  "")
                @StatRow("En eski (sn)",      FormatNum(a.OldestSeconds), StatClass(a.OldestSeconds ?? 0, a.WarnAfter, a.BreachAfter))
                @StatRow("Warn eşiği (sn)",   a.WarnAfter.ToString(),     "")
                @StatRow("Breach eşiği (sn)", a.BreachAfter.ToString(),   "")
                @StatRow("Breach aksiyonu",   a.OnBreach ?? "—",          "")
                @StatRow("Son ihlaller",      a.BreachCountRecent.ToString(), a.BreachCountRecent > 0 ? "breach" : "")
            }
            else
            {
                <p class="muted">Yükleniyor…</p>
            }
        </div>
        <div class="sla-card">
            <h3>🚨 Eskalasyonlar</h3>
            @if (_status?.Escalations is { } ev)
            {
                @StatRow("Açık sayı",         ev.OpenCount.ToString(),    "")
                @StatRow("En eski (sn)",       FormatNum(ev.OldestSeconds), StatClass(ev.OldestSeconds ?? 0, ev.WarnAfter, ev.BreachAfter))
                @StatRow("Warn eşiği (sn)",    ev.WarnAfter.ToString(),   "")
                @StatRow("Breach eşiği (sn)",  ev.BreachAfter.ToString(), "")
                @StatRow("Priority boost",     ev.BoostPriorityOnBreach ? "aktif" : "pasif", "")
                @StatRow("Son ihlaller",       ev.BreachCountRecent.ToString(), ev.BreachCountRecent > 0 ? "breach" : "")
            }
            else
            {
                <p class="muted">Yükleniyor…</p>
            }
        </div>
    </div>

    <div class="sla-card" style="margin-top:16px;">
        <h3>📜 Son Olaylar</h3>
        <div class="sla-event-list">
            @if (!_events.Any())
            {
                <div class="sla-empty">Henüz olay yok.</div>
            }
            else
            {
                @foreach (var e in _events)
                {
                    <div class="sla-event">
                        <span class="ts" title="@e.Timestamp.ToString("O")">@FmtTs(e.Timestamp)</span>
                        <span class="kind">@e.Kind</span>
                        <span class="severity @e.Severity.ToLowerInvariant()">@e.Severity</span>
                        <span class="target">@e.TargetId@(e.Action is not null ? $" · {e.Action}" : "")</span>
                        <span class="age">@(e.AgeSeconds?.ToString("F0") ?? "0")s</span>
                        @if (e.Note is not null) { <span class="note">@e.Note</span> }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private SlaStatus?     _status;
    private List<SlaEvent> _events      = [];
    private bool           _autoRefresh = true;
    private bool           _pageVisible = true;
    private Timer?         _timer;
    private DotNetObjectReference<Sla>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("eval", @"
            window.__slaSetup = function(ref) {
                window.__slaRef = ref;
                document.addEventListener('visibilitychange', function() {
                    if (window.__slaRef)
                        window.__slaRef.invokeMethodAsync('OnVisibilityChange', !document.hidden).catch(function(){});
                });
            };");
        await JS.InvokeVoidAsync("__slaSetup", _dotNetRef);
        await RefreshAsync();
        if (_autoRefresh) StartTimer();
    }

    [JSInvokable]
    public async Task OnVisibilityChange(bool visible)
    {
        _pageVisible = visible;
        if (visible && _autoRefresh) await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _status = await SlaApi.GetStatusAsync();
        _events = await SlaApi.GetEventsAsync();
        StateHasChanged();
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        _timer = new Timer(async _ =>
        {
            if (!_pageVisible) return;
            try { await InvokeAsync(RefreshAsync); }
            catch (ObjectDisposedException) { }
            catch (TaskCanceledException) { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void OnAutoRefreshChanged()
    {
        if (_autoRefresh) StartTimer();
        else { _timer?.Dispose(); _timer = null; }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_timer is not null) await _timer.DisposeAsync();
    }

    private static string FmtTs(DateTimeOffset dt) => dt.LocalDateTime.ToString("HH:mm:ss");
    private static string FormatNum(double? v) => v?.ToString("F0") ?? "0";
    private static string StatClass(double actual, double warn, double breach) =>
        actual >= breach ? "breach" : actual >= warn ? "warn" : "";

    private RenderFragment StatRow(string label, string value, string cls) =>
        @<div class="sla-stat-row">
            <span class="label">@label</span>
            <span class="value @cls">@value</span>
        </div>;
}
