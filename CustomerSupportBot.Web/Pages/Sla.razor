@page "/sla"
@layout EmptyLayout
@inject IJSRuntime JS

<link rel="stylesheet" href="css/admin.css" />
<style>
    .sla-container { padding: 20px; max-width: 1200px; margin: 0 auto; }
    .sla-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
    .sla-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
    .sla-card h3 { margin: 0 0 12px; font-size: 15px; font-weight: 600; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
    .sla-stat-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 14px; }
    .sla-stat-row .label { color: #6b7280; }
    .sla-stat-row .value { font-weight: 600; color: #111827; }
    .sla-stat-row .value.warn { color: #f59e0b; }
    .sla-stat-row .value.breach { color: #dc2626; }
    .sla-event-list { margin-top: 16px; max-height: 480px; overflow: auto; border: 1px solid #e5e7eb; border-radius: 6px; background: #fff; }
    .sla-event { display: grid; grid-template-columns: 90px 80px 70px 1fr 90px; gap: 8px; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid #f3f4f6; align-items: center; }
    .sla-event:last-child { border-bottom: none; }
    .sla-event .ts { color: #6b7280; font-family: ui-monospace, monospace; }
    .sla-event .kind { font-weight: 600; text-transform: capitalize; }
    .sla-event .severity { text-align: center; padding: 2px 6px; border-radius: 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .sla-event .severity.warn { background: #fef3c7; color: #92400e; }
    .sla-event .severity.breach { background: #fee2e2; color: #991b1b; }
    .sla-event .target { font-family: ui-monospace, monospace; color: #374151; }
    .sla-event .age { text-align: right; color: #6b7280; font-family: ui-monospace, monospace; }
    .sla-event .note { grid-column: 4 / 6; color: #4b5563; font-style: italic; padding-top: 2px; }
    .sla-toolbar { display: flex; justify-content: space-between; align-items: center; }
    .sla-empty { padding: 24px; text-align: center; color: #9ca3af; font-size: 13px; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .pill.ok { background: #d1fae5; color: #065f46; }
    .pill.off { background: #f3f4f6; color: #6b7280; }
</style>

<div class="sla-container">
    <div class="sla-toolbar">
        <h1>⏱️ SLA Guardian</h1>
        <div>
            <span id="enabledPill" class="pill off">durum bilinmiyor</span>
            <button id="refreshBtn" type="button">Yenile</button>
            <label style="margin-left:8px; font-size:12px; color:#4b5563;">
                <input type="checkbox" id="autoRefresh" checked /> Auto (5sn)
            </label>
        </div>
    </div>
    <p class="muted">Bekleyen onayları ve açık eskalasyonları periyodik tarayan arka plan servisi.
       Eşik aşan onaylar otomatik reddedilir; eskalasyonların önceliği yükseltilir.</p>

    <div class="sla-grid">
        <div class="sla-card">
            <h3>📋 Onay Kuyruğu</h3>
            <div id="approvalsBlock"><p class="muted">Yükleniyor…</p></div>
        </div>
        <div class="sla-card">
            <h3>🚨 Eskalasyonlar</h3>
            <div id="escalationsBlock"><p class="muted">Yükleniyor…</p></div>
        </div>
    </div>

    <div class="sla-card" style="margin-top:16px;">
        <h3>📜 Son Olaylar</h3>
        <div id="eventList" class="sla-event-list">
            <div class="sla-empty">Henüz olay yok.</div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("loadScript", "/js/auth.js", "js-auth");
            await JS.InvokeVoidAsync("eval", "window.Auth.requireAuth()");
            await JS.InvokeVoidAsync("loadScript", "/js/admin-nav.js", "js-admin-nav");
            await JS.InvokeVoidAsync("loadScript", "/js/sla.js", "js-sla");
        }
    }
}
