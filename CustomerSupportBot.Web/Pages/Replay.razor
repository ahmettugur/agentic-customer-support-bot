@page "/replay"
@layout EmptyLayout
@inject IJSRuntime JS

<link rel="stylesheet" href="css/replay.css" />

<div class="replay-layout">
    <!-- HEADER -->
    <header class="replay-header">
        <div class="replay-header-left">
            <a href="/traces" class="btn-icon" title="Trace listesine dön">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </a>
            <div class="replay-header-info">
                <h1>Trace Replay</h1>
                <p class="muted" id="replayMeta">Bir trace ID girin veya seçin…</p>
            </div>
        </div>
        <div class="replay-header-right">
            <input id="traceIdInput" type="text" placeholder="trace ID" class="replay-input" />
            <button id="loadTraceBtn" class="btn-secondary">Yükle</button>
        </div>
    </header>

    <!-- TRANSPORT -->
    <section class="replay-controls" id="replayControls" hidden="">
        <button class="btn-icon" id="btnFirst" title="Başa">⏮</button>
        <button class="btn-icon" id="btnPrev" title="Önceki adım">◀</button>
        <button class="btn-primary" id="btnPlay" title="Oynat">▶ Oynat</button>
        <button class="btn-icon" id="btnNext" title="Sonraki adım">▶</button>
        <button class="btn-icon" id="btnLast" title="Sona">⏭</button>
        <span class="replay-step-label" id="stepLabel">0 / 0</span>
        <label class="replay-speed">
            Hız:
            <select id="speedSelect">
                <option value="2000">0.5×</option>
                <option value="1000" selected="">1×</option>
                <option value="500">2×</option>
                <option value="200">5×</option>
            </select>
        </label>
    </section>

    <!-- BODY -->
    <main class="replay-main" id="replayMain" hidden="">
        <aside class="replay-timeline-pane">
            <h3>Zaman Çizelgesi</h3>
            <ol class="replay-timeline" id="timelineList"></ol>
        </aside>
        <section class="replay-detail-pane">
            <header class="replay-detail-header" id="detailHeader">
                <span class="replay-step-num" id="detailStepNum">—</span>
                <span class="replay-step-kind" id="detailStepKind">step</span>
                <span class="replay-step-time" id="detailStepTime"></span>
            </header>
            <div class="replay-detail-body" id="detailBody">
                <p class="muted">Bir adım seç ya da Oynat'a bas.</p>
            </div>
        </section>
    </main>

    <div class="replay-empty" id="replayEmpty">
        <p class="muted">Yüklenmiş trace yok. Üst sağdaki kutuya bir <code>traceId</code> yapıştırıp <strong>Yükle</strong> deyin.</p>
        <p class="muted">İpucu: <a href="/traces">Trace Dashboard</a>'tan bir trace seç → "Replay" butonu.</p>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("loadScript", "/js/auth.js", "js-auth");
            await JS.InvokeVoidAsync("eval", "window.Auth.requireAuth()");
            await JS.InvokeVoidAsync("loadScript", "/js/admin-nav.js", "js-admin-nav");
            await JS.InvokeVoidAsync("loadScript", "/js/replay.js", "js-replay");
        }
    }
}
