@using Microsoft.AspNetCore.Components

<div class="message @RoleClass" role="article">
    @if (Role == "user")
    {
        <div class="message-bubble user-bubble">@Content</div>
    }
    else if (Role == "assistant")
    {
        <div class="message-bubble assistant-bubble">
            <div class="message-text">@((MarkupString)Content)</div>
        </div>
    }
    else if (Role == "error")
    {
        <div class="message-bubble error-bubble">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" x2="12" y1="8" y2="12"/>
                <line x1="12" x2="12.01" y1="16" y2="16"/>
            </svg>
            @Content
        </div>
    }
    else if (Role == "system")
    {
        <div class="system-notice">@Content</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "assistant";
    [Parameter, EditorRequired] public string Content { get; set; } = string.Empty;

    private string RoleClass => Role switch
    {
        "user"      => "message--user",
        "assistant" => "message--assistant",
        "error"     => "message--error",
        "system"    => "message--system",
        _           => string.Empty
    };
}
