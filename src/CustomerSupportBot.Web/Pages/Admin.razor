@page "/admin"
@attribute [Authorize(Roles = "Admin,Agent")]
@layout AdminLayout
@inject AdminApiService AdminApi
@inject AnalyticsApiService AnalyticsApi
@inject AuthTokenStore TokenStore
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject HttpClient Http
@inject ToastService Toast
@inject NavigationManager Nav
@inject StaffBadgeState Badges
@implements IAsyncDisposable

<div class="admin-layout">
    @if (_errorMessage is not null)
    {
        <div class="error-banner" role="alert">
            <span>@_errorMessage</span>
            <button type="button" class="btn-icon" @onclick="() => _errorMessage = null" aria-label="Uyarıyı kapat"><Icon Name="x" /></button>
        </div>
    }

    @* Bölüm başlığı. Gezinme kenar çubuğunda (StaffSidebar); eski üst başlık kartı ve sekme şeridi kaldırıldı. *@
    <header class="page-header">
        <div class="page-header-text">
            <h1>@SectionTitle</h1>
            <p>@SectionDescription</p>
        </div>
        <div class="page-header-actions">
            @if (_myPresence is not null)
            {
                <label class="presence-picker presence-@_myPresence.Presence"
                       title="@(_myPresence.ChosenPresence == "online" ? "Yeni eskalasyonlar size önerilebilir" : "Yeni eskalasyon önerilmez")">
                    <span class="presence-dot" aria-hidden="true"></span>
                    <select aria-label="Durumum" value="@_myPresence.ChosenPresence" @onchange="OnMyPresenceChangedAsync">
                        <option value="online">Çevrimiçi</option>
                        <option value="away">Uzakta</option>
                        <option value="offline">Çevrimdışı</option>
                    </select>
                </label>
            }
            <label class="live-toggle @(_autoRefresh ? "on" : "")" title="Listeleri 15 saniyede bir otomatik yenile">
                <input type="checkbox" @bind="_autoRefresh" @bind:after="OnAutoRefreshChanged" />
                <span class="live-dot" aria-hidden="true"></span>
                <span>@(_autoRefresh ? "Canlı · 15 sn'de bir" : "Otomatik yenileme kapalı")</span>
            </label>
            <button type="button" class="btn-icon-bordered" @onclick="RefreshNowAsync" aria-label="Şimdi yenile" title="Şimdi yenile">
                <Icon Name="refresh" />
            </button>
        </div>
    </header>

    <main class="admin-main">

        <!-- BÖLÜM: ONAYLAR — liste + ayrıntı -->
        @if (_activeTab == "approvals")
        {
            var visibleApprovals = VisibleApprovals;
            var selected = SelectedApproval(visibleApprovals);
            <section id="panel-approvals" class="tab-content active" aria-label="Onaylar">
                @if (_pendingApprovals.Count > 0)
                {
                    <div class="filter-chips" role="group" aria-label="Talep türü filtresi">
                        @foreach (var f in ApprovalFilters())
                        {
                            var key = f.Key;
                            <button type="button" class="chip @(_approvalFilter == key ? "on" : "")" aria-pressed="@(_approvalFilter == key ? "true" : "false")"
                                    @onclick="() => SetApprovalFilter(key)">
                                @f.Label <span class="chip-count">@f.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (_pendingApprovals.Count == 0)
                {
                    <div class="queue-empty">
                        <span class="queue-empty-icon"><Icon Name="check" Size="22" StrokeWidth="2.2" /></span>
                        <strong>Kuyruk boş</strong>
                        <span>Bekleyen talep yok. Yeni talep gelince burada görünür.</span>
                    </div>
                }
                else
                {
                    <div class="master-detail">
                        <div class="md-list" role="list" aria-label="Bekleyen talepler">
                            @if (visibleApprovals.Count == 0)
                            {
                                <div class="md-list-empty">Bu filtrede bekleyen talep yok.</div>
                            }
                            @foreach (var row in visibleApprovals)
                            {
                                var item = row;
                                var isSel = selected?.Id == row.Id;
                                var rowCustomer = row.CustomerName ?? row.CustomerId ?? ParamString(row.Parameters, "customerId");
                                <button type="button" role="listitem" class="md-row @(isSel ? "selected" : "") @(_decidingApprovals.Contains(row.Id) ? "deciding" : "")"
                                        aria-current="@(isSel ? "true" : null)" @onclick="() => SelectApproval(item)">
                                    <span class="type-icon @ToolTone(row.ToolName)"><Icon Name="@ToolIcon(row.ToolName)" Size="17" /></span>
                                    <span class="md-row-main">
                                        <span class="md-row-title">
                                            @ToolDisplayName(row.ToolName)
                                            @if (row.ReasonRequired) { <span class="risk-tag">Yüksek risk</span> }
                                        </span>
                                        <span class="md-row-sub">@(rowCustomer ?? "Müşteri bilinmiyor")@(string.IsNullOrWhiteSpace(row.UserQuery) ? "" : $" · {row.UserQuery}")</span>
                                    </span>
                                    <span class="wait @(IsLongWait(row) ? "long" : "")" title="@row.RequestedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")">
                                        <Icon Name="clock" Size="13" StrokeWidth="2" />@FmtRelative(row.RequestedAt).Replace(" önce", "")
                                    </span>
                                </button>
                            }
                        </div>

                        @if (selected is { } a)
                        {
                            @* Bilgi hiyerarşisi: "kimin adına, ne yapılacak?" en üstte ve insan diliyle;
                               makine kimlikleri (tool adı, kayıt no, session, ham parametreler) en altta,
                               katlanmış "Teknik ayrıntı" bloğunda. *@
                            var deciding = _decidingApprovals.Contains(a.Id);
                            var noteMissing = a.ReasonRequired && string.IsNullOrWhiteSpace(_approvalNote);
                            <article class="md-detail card-approval @(deciding ? "deciding" : "")" aria-busy="@(deciding ? "true" : "false")" aria-label="Talep ayrıntısı">
                                <header class="md-detail-header">
                                    <div class="md-detail-title">
                                        <span class="type-icon @ToolTone(a.ToolName)"><Icon Name="@ToolIcon(a.ToolName)" Size="18" /></span>
                                        <h2 class="approval-action">@ToolDisplayName(a.ToolName)</h2>
                                        @{ var customerId = a.CustomerId ?? ParamString(a.Parameters, "customerId"); }
                                        @if (!string.IsNullOrWhiteSpace(customerId))
                                        {
                                            <span class="approval-customer">
                                                @if (!string.IsNullOrWhiteSpace(a.CustomerName))
                                                {
                                                    <span class="ac-name">@a.CustomerName</span>
                                                }
                                                <span class="ac-id">#@customerId</span>
                                            </span>
                                        }
                                        @if (a.ReasonRequired)
                                        {
                                            <span class="risk-tag" title="Yüksek riskli işlem — onaylarken gerekçe zorunlu">Yüksek risk · gerekçe zorunlu</span>
                                        }
                                    </div>
                                    <div class="md-detail-meta">
                                        <span class="@(IsLongWait(a) ? "wait-text long" : "wait-text")">@FmtRelative(a.RequestedAt).Replace(" önce", "") bekliyor</span>
                                        <span>Talep: @a.RequestedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                                        @if (!string.IsNullOrWhiteSpace(a.AgentName)) { <span>@AgentDisplayName(a.AgentName) önerdi</span> }
                                    </div>
                                </header>
                                <div class="card-body md-detail-body">

                                @* ── Kararın dayanağı: ne yapılacak? Kartın en baskın öğesi. ── *@
                                @{
                                    var orderLines = ApprovalLines(a.Parameters);
                                    var facts      = ApprovalFacts(a);
                                }
                                @if (orderLines is not null)
                                {
                                    <table class="approval-lines">
                                        <caption class="sr-only">Sipariş kalemleri</caption>
                                        <tbody>
                                            @foreach (var line in orderLines)
                                            {
                                                <tr>
                                                    <td class="al-product">@line.Product</td>
                                                    <td class="al-qty"><strong>@line.Quantity</strong> adet</td>
                                                </tr>
                                            }
                                        </tbody>
                                        @if (orderLines.Count > 1)
                                        {
                                            <tfoot>
                                                <tr>
                                                    <td>@orderLines.Count kalem</td>
                                                    <td class="al-qty">Toplam <strong>@orderLines.Sum(l => l.Quantity)</strong> adet</td>
                                                </tr>
                                            </tfoot>
                                        }
                                    </table>
                                }
                                else if (facts is not null)
                                {
                                    <dl class="approval-facts">
                                        @foreach (var fact in facts)
                                        {
                                            <div class="af-row @(fact.Multiline ? "af-row-block" : null)">
                                                <dt>@fact.Label</dt>
                                                <dd>@fact.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                }
                                else
                                {
                                    // Tanınmayan tool — ham anahtar/değer listesine düş.
                                    // Fotoğraf kimlikleri yukarıda resim olarak gösterilir; metin listesinde tekrarlanmaz.
                                    var paramFields = ParseJsonFields(a.Parameters)?.Where(f => f.Key != "attachmentIds").ToList();
                                    if (paramFields is { Count: 0 }) paramFields = null;
                                    if (paramFields is not null)
                                    {
                                        <div class="param-list">
                                            @foreach (var (k, v) in paramFields)
                                            {
                                                <div class="param-row"><span class="param-key">@k</span><span class="param-val">@v</span></div>
                                            }
                                        </div>
                                    }
                                }

                                @{ var photoIds = AttachmentIds(a.Parameters); }
                                @if (photoIds.Count > 0)
                                {
                                    <ApprovalPhotos Ids="photoIds" />
                                }

                                @if (!string.IsNullOrWhiteSpace(a.UserQuery))
                                {
                                    <blockquote class="approval-quote">@a.UserQuery</blockquote>
                                }

                                @if (HasMeaningfulJustification(a.Justification))
                                {
                                    <p class="approval-rationale"><span class="label">Gerekçe:</span> @a.Justification</p>
                                }

                                @* Makine kimlikleri — karar için gerekmez, hata ayıklama için gerekir. *@
                                <details class="approval-tech">
                                    <summary>Teknik ayrıntı</summary>
                                    <div class="at-grid">
                                        <span class="at-key">Tool</span><code class="at-val">@a.ToolName</code>
                                        <span class="at-key">Ajan</span><span class="at-val">@a.AgentName</span>
                                        <span class="at-key">Kayıt</span><code class="at-val">@a.Id</code>
                                        <span class="at-key">Session</span><code class="at-val">@ShortId(a.SessionId)</code>
                                        @if (!string.IsNullOrWhiteSpace(a.TraceId))
                                        {
                                            <span class="at-key">Trace</span>
                                            <span class="at-val">
                                                <a class="trace-link" href="@($"/replay?traceId={Uri.EscapeDataString(a.TraceId)}")" target="_blank" rel="noopener">Karar izini aç <Icon Name="external" Size="12" /></a>
                                            </span>
                                        }
                                    </div>
                                    @{ var rawFields = ParseJsonFields(a.Parameters); }
                                    @if (rawFields is not null)
                                    {
                                        <div class="param-list at-params">
                                            @foreach (var (k, v) in rawFields)
                                            {
                                                <div class="param-row"><span class="param-key">@k</span><span class="param-val">@v</span></div>
                                            }
                                        </div>
                                    }
                                </details>
                            </div>
                            
                                <footer class="md-detail-footer">
                                    <label class="decision-note">
                                        <span>@(a.ReasonRequired ? "Onay gerekçesi (zorunlu — yüksek riskli işlem)" : "Karar notu (isteğe bağlı)")</span>
                                        <textarea rows="2" maxlength="500" placeholder="Karar notu…" disabled="@deciding"
                                                  @bind="_approvalNote" @bind:event="oninput"></textarea>
                                    </label>
                                    <div class="decision-actions">
                                        @if (deciding)
                                        {
                                            <span class="muted deciding-label" role="status">İşleniyor…</span>
                                        }
                                        else if (noteMissing)
                                        {
                                            <span class="muted deciding-label">Onaylamak için gerekçe yazın.</span>
                                        }
                                        <button type="button" class="btn-danger" disabled="@deciding" @onclick="() => DecideApprovalAsync(a, false)">
                                            <Icon Name="x" StrokeWidth="2.2" /> Reddet
                                        </button>
                                        <button type="button" class="btn-primary" disabled="@(deciding || noteMissing)" @onclick="() => DecideApprovalAsync(a, true)">
                                            <Icon Name="check" StrokeWidth="2.2" /> Onayla
                                        </button>
                                    </div>
                                </footer>
                            </article>
                        }
                    </div>
                }
            </section>
        }

        <!-- TAB: ESCALATIONS -->
        <section id="panel-escalations" class="tab-content @ActiveCls("escalations")" role="tabpanel" aria-labelledby="tab-escalations">
            @if (!_isAgent && _agentPresence.Count > 0)
            {
                <div class="presence-strip" role="status" aria-label="Temsilci durumları">
                    <span class="presence-strip-title">Temsilciler</span>
                    @foreach (var a in _agentPresence)
                    {
                        <span class="presence-chip presence-@a.Presence"
                              title="@PresenceLabel(a.Presence) · yük @a.CurrentLoad/@a.MaxConcurrentLoad">
                            <span class="presence-dot" aria-hidden="true"></span>
                            @a.DisplayName
                            <span class="presence-load">@a.CurrentLoad/@a.MaxConcurrentLoad</span>
                            @if (a.InVoiceCall)
                            {
                                <span class="presence-call"><Icon Name="phone" Size="12" /> Görüşmede</span>
                            }
                            <span class="visually-hidden">@PresenceLabel(a.Presence)</span>
                        </span>
                    }
                    @if (_agentPresence.All(a => a.Presence != "online"))
                    {
                        <span class="presence-strip-note">Çevrimiçi temsilci yok — yeni eskalasyonlar atanmadan kuyrukta bekler.</span>
                    }
                </div>
            }
            <div class="escalations-layout">
                <aside class="escalations-sidebar">
                    <h3>Son kapananlar <span class="badge badge-muted">@_closedEscalations.Count</span></h3>
                    <div class="cards-list compact">
                        @if (_closedEscalations.Count == 0) { <div class="empty-state">Henüz kapanmış eskalasyon yok.</div> }
                        else
                        {
                            @foreach (var e in _closedEscalations)
                            {
                                var isReplan = e.Resolution is not null &&
                                    e.Resolution.Contains("yeniden planla", StringComparison.OrdinalIgnoreCase);
                                <article class="card card-history compact-card">
                                    <header class="card-header">
                                        <div class="card-title">
                                            <span class="status-tag @e.Status">@EscalationStatusLabel(e.Status)</span>
                                            @if (isReplan)
                                            {
                                                <span class="status-tag status-tag--replan" title="Yeniden planla ile kapatıldı">Yeniden planlandı</span>
                                            }
                                            <code class="card-id">@ShortId(e.Id)</code>
                                        </div>
                                        <time class="muted">@FmtRelative(e.CreatedAt)</time>
                                    </header>
                                    <div class="card-body">
                                        <div class="card-row"><span class="label">Sebep:</span> <span class="user-query">@e.Reason</span></div>
                                        @if (e.AssignedTo is not null)
                                        {
                                            <div class="card-row"><span class="label">Temsilci:</span> <span>@e.AssignedTo</span></div>
                                        }
                                        @if (e.Resolution is not null)
                                        {
                                            <div class="card-row card-resolution">
                                                <span class="label">@(isReplan ? "Yönlendirme notu:" : "Kapatma notu:")</span>
                                                <span class="resolution-text">@e.Resolution</span>
                                            </div>
                                        }
                                    </div>
                                    <footer class="card-actions compact-actions">
                                        <button class="btn-secondary btn-sm" @onclick="() => ShowTranscriptAsync(e.SessionId)">Konuşmayı gör</button>
                                    </footer>
                                </article>
                            }
                        }
                    </div>
                </aside>
                <div class="escalations-main">
                    <div class="cards-list">
                        @if (_openEscalations.Count == 0)
                        {
                            <div class="queue-empty">
                                <span class="queue-empty-icon"><Icon Name="check" Size="22" StrokeWidth="2.2" /></span>
                                <strong>Açık eskalasyon yok</strong>
                                <span>Asistanın temsilciye aktardığı konuşmalar burada görünür.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var e in _openEscalations)
                            {
                                var esc = e;
                                var isAcknowledged = e.Status is "acknowledged";
                                var menuOpen = _escMenuOpenId == e.Id;
                                <article class="card card-escalation @(isAcknowledged ? "card-acknowledged" : "")">
                                    <header class="esc-header">
                                        <span class="esc-status @(isAcknowledged ? "taken" : "open")">
                                            @if (isAcknowledged && e.AssignedTo is not null)
                                            {
                                                <span title="Bu eskalasyonu @e.AssignedTo üstlendi">@e.AssignedTo üstlendi</span>
                                            }
                                            else
                                            {
                                                <span>@EscalationStatusLabel(e.Status)</span>
                                            }
                                        </span>
                                        <h2 class="esc-title">@(string.IsNullOrWhiteSpace(e.Reason) ? "Temsilci gerekiyor" : e.Reason)</h2>
                                        <time class="esc-time" title="@e.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")">@FmtRelative(e.CreatedAt)</time>
                                    </header>
                                    <div class="esc-meta">
                                        <span>@AgentDisplayName(e.AgentName) aktardı</span>
                                        <span>Atanan: @(e.AssignedTo ?? "—")</span>
                                        <code class="card-id" title="@e.Id">@ShortId(e.Id)</code>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(e.UserQuery))
                                    {
                                        <blockquote class="approval-quote">@e.UserQuery</blockquote>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.ResponseSummary))
                                    {
                                        <p class="esc-summary"><strong>Asistan özeti:</strong> @e.ResponseSummary</p>
                                    }
                                    @if (e.MissingContext is { Length: > 0 } missing)
                                    {
                                        <div class="esc-missing">
                                            <span>Eksik bilgi:</span>
                                            @foreach (var m in missing) { <span class="missing-chip">@m</span> }
                                        </div>
                                    }
                                    <footer class="card-actions esc-actions">
                                        <button class="btn-primary" @onclick="() => TakeoverAndChatAsync(esc)"
                                                disabled="@isAcknowledged" title="@(isAcknowledged ? "Zaten üstlenildi" : null)">
                                            <Icon Name="message" /> Devral ve sohbet et
                                        </button>
                                        <button class="btn-secondary" @onclick="() => ShowAssignModalAsync(esc.Id)"
                                                disabled="@isAcknowledged" title="@(isAcknowledged ? "Zaten üstlenildi" : null)">Temsilciye ata</button>
                                        <div class="menu-wrap">
                                            <button type="button" class="btn-icon-bordered" aria-label="Diğer işlemler" aria-haspopup="menu"
                                                    aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => ToggleEscMenu(esc.Id)">
                                                <Icon Name="more" StrokeWidth="2.4" />
                                            </button>
                                            @if (menuOpen)
                                            {
                                                <div class="menu-scrim" @onclick="CloseEscMenu"></div>
                                                <div class="menu" role="menu" aria-label="Diğer işlemler">
                                                    <button type="button" role="menuitem" @onclick='() => { CloseEscMenu(); ShowPrompt(PromptKind.ReplanEscalation, esc.Id, "Asistana yeniden planlat", "Not (isteğe bağlı)"); }'>
                                                        <Icon Name="refresh" /> Asistana yeniden planlat
                                                    </button>
                                                    <button type="button" role="menuitem" @onclick='() => { CloseEscMenu(); ShowPrompt(PromptKind.ResolveEscalation, esc.Id, "Çözüldü olarak işaretle", "Çözüm açıklaması"); }'>
                                                        <Icon Name="check" /> Çözüldü olarak işaretle
                                                    </button>
                                                    <div class="menu-sep" role="separator"></div>
                                                    <button type="button" role="menuitem" class="danger" @onclick='() => { CloseEscMenu(); ShowPrompt(PromptKind.DismissEscalation, esc.Id, "Gereksiz — kapat", "Kapatma sebebi"); }'>
                                                        <Icon Name="x" /> Gereksiz — kapat
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </footer>
                                </article>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB: ACTIVE CHATS -->
        <section id="panel-chats" class="tab-content @ActiveCls("chats")" role="tabpanel" aria-labelledby="tab-chats">
            <div class="chats-layout">
                <aside class="chats-sidebar">
                    <h3>Aktif oturumlar</h3>
                    <div class="cards-list">
                        @if (_activeChats.Count == 0) { <div class="empty-state">Aktif sohbet yok.</div> }
                        else
                        {
                            @foreach (var c in _activeChats)
                            {
                                <article class="card card-active-chat">
                                    <header class="card-header">
                                        <div class="card-title"><span class="status-tag human">Canlı</span><code class="card-id">@ShortId(c.SessionId)</code></div>
                                        <time class="muted">@FmtRelative(c.EnteredHumanModeAt)</time>
                                    </header>
                                    <div class="card-body">
                                        <div class="card-row"><span class="label">Temsilci:</span> <span>@(c.HumanAgent ?? "—")</span></div>
                                        <div class="card-row"><span class="label">Mesaj:</span> <span>@c.MessageCount</span></div>
                                    </div>
                                    <footer class="card-actions">
                                        <button class="btn-primary" @onclick="() => OpenChatPanelAsync(c)">Sohbeti aç</button>
                                    </footer>
                                </article>
                            }
                        }
                    </div>
                </aside>
                <div class="chat-panel-host">
                    @if (_openChatSession is null)
                    {
                        <div class="empty-state">Soldan bir oturum seçin ya da bir eskalasyonu devralın.</div>
                    }
                    else
                    {
                        <div class="chat-panel">
                            <header class="chat-panel-header">
                                <div class="chat-panel-title">
                                    <span class="status-tag human">Canlı</span>
                                    <div>
                                        <div class="chat-panel-session">@ShortId(_openChatSession.SessionId)…</div>
                                        <div class="chat-panel-subtitle">Temsilci: @_openChatSession.HumanAgent · Giriş: @FmtTs(_openChatSession.EnteredHumanModeAt)</div>
                                    </div>
                                </div>
                                @if (_sentimentLabel is not null)
                                {
                                    <span class="sentiment-badge sentiment-@_sentimentLabel.ToLowerInvariant()" title="Duygu skoru: @_sentimentScore.ToString("F2")">
                                        @SentimentLabel(_sentimentLabel) (@_sentimentScore.ToString("F1"))
                                    </span>
                                }
                                <StaffVoiceCallBar @ref="_voiceBar" SessionId="@_openChatSession.SessionId" @key="_openChatSession.SessionId" />
                                <button class="btn-secondary @(_assistOpen ? "active" : "")" @onclick="ToggleAssistAsync" aria-pressed="@_assistOpen" title="Özet, müşteri bağlamı ve yanıt taslağı"><Icon Name="sparkles" /> Asistan</button>
                                <button class="btn-secondary" @onclick='() => ShowPrompt(PromptKind.ReplanChat, _openChatSession.SessionId, "Asistana yeniden planlat", "Not (isteğe bağlı)")'><Icon Name="refresh" /> Yeniden planla</button>
                                <button class="btn-danger" @onclick="ReleaseChatAsync">Sohbeti bitir</button>
                            </header>
                            @if (_assistOpen)
                            {
                                <aside class="assist-card" aria-label="Temsilci asistanı" aria-busy="@_assistLoading">
                                    <div class="assist-card-header">
                                        <strong><Icon Name="sparkles" /> Temsilci asistanı</strong>
                                        <button class="btn-secondary btn-sm" @onclick="LoadAssistAsync" disabled="@_assistLoading">@(_assistLoading ? "Hazırlanıyor…" : "Yenile")</button>
                                    </div>
                                    @if (_assistLoading && _assist is null)
                                    {
                                        <p class="muted">Konuşma özetleniyor ve taslak hazırlanıyor…</p>
                                    }
                                    else if (_assistLoadError is not null)
                                    {
                                        <p class="assist-error">@_assistLoadError</p>
                                    }
                                    else if (_assist is not null)
                                    {
                                        @if (_assist.AssistError is not null)
                                        {
                                            <p class="assist-error">@_assist.AssistError</p>
                                        }
                                        @if (_assist.Summary is not null)
                                        {
                                            <div class="assist-section">
                                                <h4>Özet</h4>
                                                <p>@_assist.Summary</p>
                                                @if (_assist.CustomerRequest is not null)
                                                {
                                                    <p><strong>Müşterinin talebi:</strong> @_assist.CustomerRequest</p>
                                                }
                                            </div>
                                        }
                                        @if (_assist.SuggestedReply is not null)
                                        {
                                            <div class="assist-section">
                                                <h4>Önerilen yanıt</h4>
                                                <p class="assist-draft">@_assist.SuggestedReply</p>
                                                <button class="btn-primary btn-sm" @onclick="UseAssistDraft">Taslağı kullan</button>
                                                <span class="muted assist-hint">Mesaj kutusuna alınır; göndermeden önce düzenleyebilirsiniz.</span>
                                            </div>
                                        }
                                        <div class="assist-section">
                                            <h4>Müşteri</h4>
                                            <p>
                                                Duygu: <strong>@SentimentLabel(_assist.Sentiment.Label)</strong> (@_assist.Sentiment.Score.ToString("F1"))
                                                @if (_assist.Sentiment.ConsecutiveNegativeTurns > 0)
                                                {
                                                    <span> · @_assist.Sentiment.ConsecutiveNegativeTurns ardışık olumsuz tur</span>
                                                }
                                            </p>
                                            @if (_assist.Profile is { } p)
                                            {
                                                @if (!string.IsNullOrWhiteSpace(p.Summary)) { <p>@p.Summary</p> }
                                                <p class="muted">
                                                    Ton: @p.PreferredTone · @p.TotalSessions oturum
                                                    @if (p.AverageRating is not null) { <span> · ort. puan @p.AverageRating.Value.ToString("0.0")/5</span> }
                                                    @if (p.ProductInterests.Count > 0) { <span> · ilgi: @string.Join(", ", p.ProductInterests)</span> }
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="muted">Kayıtlı müşteri profili yok.</p>
                                            }
                                        </div>
                                        @if (_assist.OpenItems.Count > 0)
                                        {
                                            <div class="assist-section">
                                                <h4>Açık işler</h4>
                                                <ul>
                                                    @foreach (var item in _assist.OpenItems)
                                                    {
                                                        <li>@AssistItemLabel(item) <span class="muted">(@item.Status)</span></li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        @if (_assist.Articles.Count > 0)
                                        {
                                            <div class="assist-section">
                                                <h4>İlgili bilgi tabanı</h4>
                                                @foreach (var a in _assist.Articles)
                                                {
                                                    <details class="assist-article">
                                                        <summary>@a.Title</summary>
                                                        <p>@a.Snippet</p>
                                                    </details>
                                                }
                                            </div>
                                        }
                                    }
                                </aside>
                            }
                            <div class="chat-panel-messages" id="adminChatMessages">
                                @if (_chatMessages.Count == 0) { <div class="empty-state">Henüz mesaj yok.</div> }
                                @foreach (var m in _chatMessages)
                                {
                                    @if (m.VoiceCallId is not null)
                                    {
                                        var vm = m;
                                        <div class="voice-line @(vm.VoiceTrack == "agent" ? "agent" : "customer")">
                                            <Icon Name="mic" Size="13" />
                                            <span class="voice-line-text">@vm.Text</span>
                                            <button type="button" class="voice-line-play" @onclick="() => OpenPlayer(vm.VoiceCallId!, vm.OffsetMs ?? 0)"
                                                    aria-label="Kayıtta bu ana git">@FmtOffset(vm.OffsetMs ?? 0)</button>
                                        </div>
                                    }
                                    else if (m.Sender.Equals("system", StringComparison.OrdinalIgnoreCase) && m.Text.StartsWith("📋"))
                                    {
                                        var noteText = m.Text.StartsWith("📋 Temsilci yeniden planlama notu: ")
                                            ? m.Text["📋 Temsilci yeniden planlama notu: ".Length..].Trim('"')
                                            : m.Text[2..].Trim();
                                        <div class="internal-note">
                                            <div class="internal-note-header">
                                                <span class="internal-note-badge">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                                                    </svg>
                                                    Temsilci Notu
                                                </span>
                                                <span class="internal-note-time">@FmtTs(m.Timestamp)</span>
                                            </div>
                                            <p class="internal-note-body">@noteText</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chat-bubble @(m.Sender.ToLowerInvariant())">
                                            @m.Text
                                            <span class="chat-bubble-meta">@FmtTs(m.Timestamp)</span>
                                        </div>
                                    }
                                }
                            </div>
                            @if (_repliesOpen)
                            {
                                <div class="saved-reply-picker" role="dialog" aria-label="Hazır yanıtlar">
                                    <input type="search" placeholder="Hazır yanıt ara (başlık, metin, kısayol)…" aria-label="Hazır yanıt ara"
                                           @bind="_replyQuery" @bind:event="oninput" @bind:after="OnReplyQueryChangedAsync" />
                                    @if (_replyResults.Count == 0)
                                    {
                                        <div class="saved-reply-empty">Eşleşen hazır yanıt yok.</div>
                                    }
                                    else
                                    {
                                        <ul class="saved-reply-list">
                                            @foreach (var r in _replyResults)
                                            {
                                                var reply = r;
                                                <li>
                                                    <button type="button" class="saved-reply-item" @onclick="() => InsertReply(reply)">
                                                        <span class="saved-reply-title">@reply.Title
                                                            @if (!string.IsNullOrEmpty(reply.Shortcut)) { <code>@reply.Shortcut</code> }
                                                        </span>
                                                        <span class="saved-reply-body">@reply.Body</span>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                            <form class="chat-panel-composer" @onsubmit="SendChatMessageAsync" @onsubmit:preventDefault>
                                <button type="button" class="btn-secondary btn-replies @(_repliesOpen ? "active" : "")" @onclick="ToggleRepliesAsync"
                                        aria-pressed="@_repliesOpen" title="Hazır yanıt ekle" aria-label="Hazır yanıt ekle"><Icon Name="bookmark" Size="17" /></button>
                                <textarea rows="2" placeholder="Kullanıcıya yazın…" @bind="_chatInput"></textarea>
                                <button type="submit" class="btn-primary">Gönder</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- TAB: SİPARİŞLER (yalnız yönetici) — kargo/teslim durumu, müşteriye proaktif e-posta -->
        @if (!_isAgent)
        {
            <section id="panel-orders" class="tab-content @ActiveCls("orders")" role="tabpanel" aria-labelledby="tab-orders">
                <form class="card order-lookup" @onsubmit="LookupOrderAsync" @onsubmit:preventDefault>
                    <label>Sipariş no <input inputmode="numeric" maxlength="20" placeholder="ör. 1044" @bind="_orderLookupId" /></label>
                    <button type="submit" class="btn-primary" disabled="@_orderBusy">Bul</button>
                </form>
                @if (_orderError is not null)
                {
                    <p class="form-error" role="alert">@_orderError</p>
                }
                @if (_orderView is { } o)
                {
                    <article class="card order-card">
                        <header class="order-card-header">
                            <h3>Sipariş #@o.OrderId</h3>
                            <span class="status-tag">@o.Status</span>
                        </header>
                        <dl class="order-facts">
                            <dt>Müşteri</dt><dd>@o.CustomerId</dd>
                            <dt>Ürünler</dt><dd>@o.LinesSummary</dd>
                            <dt>Sipariş tarihi</dt><dd>@o.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                            @if (o.ShippedAt is { } shippedAt)
                            {
                                <dt>Kargoya verildi</dt><dd>@shippedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") @(o.Carrier is null ? "" : $"· {o.Carrier}") @(o.TrackingNumber is null ? "" : $"· {o.TrackingNumber}")</dd>
                            }
                            @if (o.DeliveredAt is { } deliveredAt)
                            {
                                <dt>Teslim edildi</dt><dd>@deliveredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                            }
                        </dl>
                        @if (o.Status == "İşleniyor")
                        {
                            <div class="order-actions">
                                <label>Kargo firması <input maxlength="64" placeholder="ör. Yurtiçi Kargo" @bind="_orderCarrier" /></label>
                                <label>Takip no <input maxlength="64" @bind="_orderTracking" /></label>
                                <button type="button" class="btn-primary" @onclick="ShipOrderAsync" disabled="@_orderBusy"><Icon Name="package" /> Kargoya verildi</button>
                            </div>
                        }
                        else if (o.Status == "Kargolandı")
                        {
                            <div class="order-actions">
                                <button type="button" class="btn-primary" @onclick="DeliverOrderAsync" disabled="@_orderBusy"><Icon Name="check" /> Teslim edildi</button>
                            </div>
                        }
                        <p class="muted small">Durum değişikliğinde müşteriye e-posta gider (<code>Email:Notifications</code>). Aynı durumu tekrar işaretlemek ikinci e-posta göndermez.</p>
                    </article>
                }
            </section>
        }

        <!-- TAB: KONUŞMA ARAMA (yalnız yönetici) -->
        @if (!_isAgent)
        {
            <section id="panel-conversations" class="tab-content @ActiveCls("conversations")" role="tabpanel" aria-labelledby="tab-conversations">
                <form class="card conversation-search-form" @onsubmit="() => SearchConversationsAsync(false)" @onsubmit:preventDefault>
                    <label class="search-text">Mesajlarda ara
                        <input type="search" maxlength="200" placeholder="ör. iade, 1030, kargo gecikti" @bind="_searchText" />
                    </label>
                    <label>Müşteri no <input maxlength="64" @bind="_searchCustomer" /></label>
                    <label>Başlangıç <input type="date" @bind="_searchFrom" /></label>
                    <label>Bitiş <input type="date" @bind="_searchTo" /></label>
                    <label>Kapanış nedeni
                        <select @bind="_searchReason">
                            <option value="">Tümü</option>
                            @foreach (var r in _searchReasons)
                            {
                                <option value="@r.Code">@r.Label</option>
                            }
                        </select>
                    </label>
                    <label>Etiket <input maxlength="30" placeholder="ör. kargo" @bind="_searchTag" /></label>
                    <div class="conversation-search-actions">
                        <button type="button" class="btn-secondary" @onclick="ClearSearchAsync" disabled="@_searching">Temizle</button>
                        <button type="submit" class="btn-primary" disabled="@_searching">@(_searching ? "Aranıyor…" : "Ara")</button>
                    </div>
                </form>

                @if (_searchError is not null)
                {
                    <p class="form-error" role="alert">@_searchError</p>
                }
                else if (_searchedOnce && _searchResults.Count == 0)
                {
                    <div class="empty-state">Eşleşen konuşma yok.</div>
                }

                <div class="conversation-search-results" aria-live="polite">
                    @foreach (var hit in _searchResults)
                    {
                        var h = hit;
                        <article class="card conversation-hit">
                            <header class="conversation-hit-header">
                                <code class="session-id" title="@h.SessionId">@ShortId(h.SessionId)</code>
                                <span class="muted">@h.LastActivity.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                <span class="muted">Müşteri: @(h.CustomerId ?? "anonim")</span>
                                <span class="muted">@h.MessageCount mesaj</span>
                            </header>
                            @if (h.Snippet is { } snippet)
                            {
                                <p class="conversation-hit-snippet">
                                    @if (h.HighlightStart is int hs && h.HighlightLength is int hl && hs >= 0 && hs + hl <= snippet.Length)
                                    {
                                        @snippet[..hs]<mark>@snippet.Substring(hs, hl)</mark>@snippet[(hs + hl)..]
                                    }
                                    else
                                    {
                                        @snippet
                                    }
                                </p>
                            }
                            <footer class="conversation-hit-footer">
                                @foreach (var r in h.Reasons)
                                {
                                    <span class="status-tag">@ReasonLabel(r)</span>
                                }
                                @foreach (var t in h.Tags)
                                {
                                    <span class="tag-chip tag-chip--static">#@t</span>
                                }
                                <button type="button" class="btn-secondary conversation-hit-open" @onclick="() => ShowTranscriptAsync(h.SessionId)">Görüntüle</button>
                            </footer>
                        </article>
                    }
                </div>
                @if (_searchHasMore)
                {
                    <button type="button" class="btn-secondary conversation-search-more" @onclick="() => SearchConversationsAsync(true)" disabled="@_searching">
                        Daha fazla
                    </button>
                }
            </section>
        }

        <!-- TAB: HAZIR YANITLAR (yalnız yönetici) -->
        @if (!_isAgent)
        {
            <section id="panel-replies" class="tab-content @ActiveCls("replies")" role="tabpanel" aria-labelledby="tab-replies">
                <div class="saved-replies-admin">
                    <form class="card saved-reply-form" @onsubmit="SaveReplyAsync" @onsubmit:preventDefault>
                        <h3>@(_replyEditId is null ? "Yeni hazır yanıt" : "Hazır yanıtı düzenle")</h3>
                        <label>Başlık <input maxlength="100" @bind="_replyTitle" required /></label>
                        <label>Kısayol <span class="muted">(isteğe bağlı, ör. kargo-gecikme)</span>
                            <input maxlength="40" @bind="_replyShortcut" />
                        </label>
                        <label>Metin <textarea rows="5" maxlength="2000" @bind="_replyBody" required></textarea></label>
                        @if (_replyFormError is not null)
                        {
                            <p class="saved-reply-error" role="alert">@_replyFormError</p>
                        }
                        <div class="saved-reply-form-actions">
                            @if (_replyEditId is not null)
                            {
                                <button type="button" class="btn-secondary" @onclick="ResetReplyForm">Vazgeç</button>
                            }
                            <button type="submit" class="btn-primary">@(_replyEditId is null ? "Ekle" : "Kaydet")</button>
                        </div>
                    </form>
                    <div class="saved-reply-table">
                        @if (_savedReplies.Count == 0)
                        {
                            <div class="empty-state">Henüz hazır yanıt yok.</div>
                        }
                        else
                        {
                            @foreach (var r in _savedReplies)
                            {
                                var reply = r;
                                <article class="card saved-reply-row">
                                    <div class="saved-reply-row-head">
                                        <strong>@reply.Title</strong>
                                        @if (!string.IsNullOrEmpty(reply.Shortcut)) { <code>@reply.Shortcut</code> }
                                        <span class="spacer"></span>
                                        <button class="btn-secondary btn-sm" @onclick="() => EditReply(reply)">Düzenle</button>
                                        <button class="btn-danger btn-sm" @onclick="() => DeleteReplyAsync(reply)">Sil</button>
                                    </div>
                                    <p class="saved-reply-row-body">@reply.Body</p>
                                </article>
                            }
                        }
                    </div>
                </div>
            </section>
        }

        <!-- TAB: ANALYTICS -->
        <section id="panel-analytics" class="tab-content @ActiveCls("analytics")" role="tabpanel" aria-labelledby="tab-analytics">

            <div class="analytics-layout">
                <!-- Session Selector Sidebar -->
                <aside class="analytics-session-sidebar">
                    <div class="analytics-sidebar-header">
                        <h3>Oturumlar</h3>
                        <button class="btn-all-analytics" @onclick="ShowAggregateAnalytics" title="Genel istatistikleri göster">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
                            </svg>
                            Genel
                        </button>
                    </div>
                    <div class="analytics-session-list">
                        @if (_analyticsSessions.Count == 0)
                        {
                            <div class="empty-state small-empty">Henüz oturum yok.</div>
                        }
                        else
                        {
                            @foreach (var s in _analyticsSessions)
                            {
                                var sid = s.SessionId;
                                <div class="analytics-session-item @(_analyticsSelectedSessionId == sid ? "active" : "")"
                                     @onclick="() => SelectAnalyticsSessionAsync(sid)">
                                    <div class="analytics-session-title">@(s.Title ?? "(boş)")</div>
                                    <div class="analytics-session-meta">
                                        <span>@s.MessageCount mesaj</span>
                                        <span>•</span>
                                        <span>@FmtRelative(s.LastActivity)</span>
                                    </div>
                                    <code class="analytics-session-id">@ShortId(s.SessionId)</code>
                                </div>
                            }
                        }
                    </div>
                </aside>

                <!-- Analytics Content -->
                <div class="analytics-content">

                    @if (!_showSessionAnalytics)
                    {
                        <!-- Aggregate View -->
                        @if (_analytics is null)
                        {
                            <div class="empty-state">Yükleniyor…</div>
                        }
                        else
                        {
                            <!-- Summary Cards Row 1 -->
                            <div class="analytics-summary">
                                <div class="analytics-card">
                                    <div class="analytics-card-icon sessions">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@_analytics.TotalSessions</div>
                                        <div class="analytics-card-label">Toplam Oturum</div>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="analytics-card-icon messages">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@_analytics.TotalMessages</div>
                                        <div class="analytics-card-label">Toplam Mesaj</div>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="analytics-card-icon rating">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@(_analytics.AverageRating > 0 ? $"{_analytics.AverageRating:F1} ★" : "—")</div>
                                        <div class="analytics-card-label">Ortalama Puan (@_analytics.TotalRatings değerlendirme)</div>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="analytics-card-icon avg">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@_analytics.AverageSessionMessages.ToString("F1")</div>
                                        <div class="analytics-card-label">Ort. Mesaj/Oturum</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Yapay zekâ çözüm oranı + görüşme başı maliyet -->
                            <div class="analytics-summary">
                                <div class="analytics-card" title="İnsan dahil olmadan (eskalasyon/devralma olmadan) biten görüşmelerin oranı">
                                    <div class="analytics-card-icon containment">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@(_analytics.EligibleSessions > 0 ? $"%{_analytics.ContainmentRate * 100:0}" : "—")</div>
                                        <div class="analytics-card-label">Yapay Zekâ Çözüm Oranı (@_analytics.ContainedSessions / @_analytics.EligibleSessions görüşme)</div>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="analytics-card-icon handoff">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 12 0v1"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@_analytics.HumanInvolvedSessions</div>
                                        <div class="analytics-card-label">İnsana Aktarılan Görüşme</div>
                                    </div>
                                </div>
                                <div class="analytics-card" title="Ortalama; medyan: @FormatUsd(_analytics.MedianCostPerConversationUsd) (@_analytics.SessionsWithCost görüşme)">
                                    <div class="analytics-card-icon cost">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@(_analytics.SessionsWithCost > 0 ? FormatUsd(_analytics.AverageCostPerConversationUsd) : "—")</div>
                                        <div class="analytics-card-label">Görüşme Başı LLM Maliyeti (medyan @FormatUsd(_analytics.MedianCostPerConversationUsd))</div>
                                    </div>
                                </div>
                                <div class="analytics-card" title="Görüşmeye atfedilemeyen (arka plan işleri): @FormatUsd(_analytics.UnattributedLlmCostUsd)">
                                    <div class="analytics-card-icon cost-total">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@FormatUsd(_analytics.TotalLlmCostUsd)</div>
                                        <div class="analytics-card-label">Toplam LLM Maliyeti</div>
                                    </div>
                                </div>
                            </div>

                            @if (_analytics.LlmBudgetEnabled)
                            {
                                <!-- LLM harcama limiti -->
                                <div class="analytics-summary analytics-summary-tight llm-budget-row">
                                    @RenderBudget("Bugünkü LLM Harcaması", _analytics.DailyLlmSpentUsd, _analytics.DailyLlmLimitUsd)
                                    @RenderBudget("Bu Ayki LLM Harcaması", _analytics.MonthlyLlmSpentUsd, _analytics.MonthlyLlmLimitUsd)
                                </div>
                            }

                            <!-- Charts Row 1: Rating dist + Approval stats + Escalation stats -->
                            <div class="analytics-charts">
                                @RenderRatingDistribution(_analytics.RatingDistribution, _analytics.TotalRatings)
                                @RenderApprovalStats(_analytics.ApprovalStats)
                                @RenderEscalationStats(_analytics.EscalationStats)
                            </div>

                            <!-- Sentiment Summary Row -->
                            <div class="analytics-summary analytics-summary-tight">
                                <div class="analytics-card">
                                    <div class="analytics-card-icon sentiment-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@(_analytics.AverageSentimentScore > 0 ? $"{(int)(_analytics.AverageSentimentScore * 100)}%" : "—")</div>
                                        <div class="analytics-card-label">Ort. Duygu Skoru</div>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="analytics-card-icon negative-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@_analytics.NegativeSessionCount</div>
                                        <div class="analytics-card-label">Olumsuz Oturum</div>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="analytics-card-icon alert-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                                    </div>
                                    <div class="analytics-card-data">
                                        <div class="analytics-card-value">@_analytics.SentimentAlertCount</div>
                                        <div class="analytics-card-label">Duygu Uyarısı</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Charts Row 2: Distribution lists -->
                            <div class="analytics-charts">
                                @RenderDist("Duygu Dağılımı", _analytics.SentimentDistribution)
                                @RenderDist("Niyet (Intent) Dağılımı", _analytics.IntentDistribution)
                                @RenderDist("Faz Dağılımı", _analytics.PhaseDistribution)
                            </div>

                            <!-- Konuşma kapanışı: temsilcinin kapattığı canlı sohbetler -->
                            <div class="analytics-charts">
                                @RenderDist("Kapanış Nedenleri", _analytics.ClosingReasons?
                                    .GroupBy(r => r.Label).ToDictionary(g => g.Key, g => g.Sum(r => r.Count)))
                                @RenderDist("Sık Etiketler", _analytics.TopTags?.ToDictionary(t => t.Tag, t => t.Count))
                            </div>

                            <!-- Charts Row 3: Recent ratings -->
                            <div class="analytics-charts">
                                @RenderRecentRatings(_analytics.RecentRatings)
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Session View -->
                        @if (_sessionAnalytics is null)
                        {
                            <div class="empty-state">Oturum analizi yükleniyor…</div>
                        }
                        else
                        {
                            var sa = _sessionAnalytics;
                            <div class="session-analytics-header">
                                <div class="session-analytics-title-row">
                                    <div>
                                        <h3>Oturum Detayı</h3>
                                        <code class="session-id">@sa.SessionId</code>
                                    </div>
                                    <span class="sentiment-badge sentiment-@(sa.Sentiment ?? "neutral")">@SentimentLabel(sa.Sentiment) (%@((int)(sa.SentimentScore * 100)))</span>
                                </div>
                                <div class="session-analytics-cards">
                                    <div class="sa-card"><div class="sa-val">@sa.MessageCount</div><div class="sa-lbl">Mesaj</div></div>
                                    <div class="sa-card"><div class="sa-val">@sa.TurnCount</div><div class="sa-lbl">Tur</div></div>
                                    <div class="sa-card"><div class="sa-val">@(sa.Phase ?? "—")</div><div class="sa-lbl">Faz</div></div>
                                    <div class="sa-card"><div class="sa-val">@(sa.CurrentIntent ?? "—")</div><div class="sa-lbl">Niyet</div></div>
                                    @if (sa.CustomerId is not null)
                                    {
                                        <div class="sa-card"><div class="sa-val">@sa.CustomerId</div><div class="sa-lbl">Müşteri</div></div>
                                    }
                                    @if (sa.Rating is not null)
                                    {
                                        <div class="sa-card">
                                            <div class="sa-val sa-stars">@(new string('★', sa.Rating.Stars))@(new string('☆', 5 - sa.Rating.Stars))</div>
                                            <div class="sa-lbl">Puan</div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="session-analytics-body">
                                @if (sa.SentimentTimeline.Count > 0)
                                {
                                    <div class="sa-section">
                                        <h4>Duygu zaman çizelgesi</h4>
                                        @if (sa.ConsecutiveNegativeTurns >= 3)
                                        {
                                            <div class="sa-warn"><Icon Name="alert" Size="14" /> Ardışık @sa.ConsecutiveNegativeTurns olumsuz tur — otomatik eskalasyon tetiklenebilir</div>
                                        }
                                        <div class="st-chart">
                                            @foreach (var e in sa.SentimentTimeline)
                                            {
                                                var barH   = Math.Max(8, (int)(e.Score * 100));
                                                var barClr = e.Score >= 0.7 ? "#22c55e" : e.Score >= 0.4 ? "#eab308" : "#ef4444";
                                                <div class="st-bar-wrap" title="Tur @e.Turn: @SentimentLabel(e.Label) (%@((int)(e.Score*100)))">
                                                    <div class="st-bar" style="height:@(barH)%;background:@barClr"></div>
                                                    <span class="st-turn">T@e.Turn</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (sa.Rating?.Feedback is not null)
                                {
                                    <div class="sa-section">
                                        <h4>Müşteri yorumu</h4>
                                        <div class="recent-rating-feedback">@sa.Rating.Feedback</div>
                                    </div>
                                }
                                @if (sa.TotalApprovals > 0)
                                {
                                    <div class="sa-section">
                                        <h4>Onay geçmişi (@sa.TotalApprovals)</h4>
                                        <div class="sa-pills">
                                            <span class="stat-pill approved sm"><span class="stat-pill-value">@sa.ApprovedCount</span><span class="stat-pill-label">Onay</span></span>
                                            <span class="stat-pill rejected sm"><span class="stat-pill-value">@sa.RejectedCount</span><span class="stat-pill-label">Red</span></span>
                                            <span class="stat-pill expired sm"><span class="stat-pill-value">@sa.ExpiredCount</span><span class="stat-pill-label">Zaman aşımı</span></span>
                                        </div>
                                        @foreach (var a in sa.ApprovalDetails)
                                        {
                                            <div class="sa-detail-item">
                                                <span title="@a.ToolName">@ToolDisplayName(a.ToolName)</span>
                                                <span class="status-tag @a.Status">@DecisionLabel(a.Status)</span>
                                                @if (a.DecidedBy is not null) { <span class="muted">· @a.DecidedBy</span> }
                                                <time class="muted">@FmtRelative(a.RequestedAt)</time>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (sa.TotalEscalations > 0)
                                {
                                    <div class="sa-section">
                                        <h4>Eskalasyonlar (@sa.TotalEscalations)</h4>
                                        @foreach (var esc in sa.EscalationDetails)
                                        {
                                            <div class="sa-detail-item">
                                                <span>@esc.Reason</span>
                                                <span class="status-tag @esc.Status">@EscalationStatusLabel(esc.Status)</span>
                                                @if (esc.AgentName is not null) { <span class="muted" title="@esc.AgentName">@AgentDisplayName(esc.AgentName)</span> }
                                                @if (esc.Resolution is not null) { <span class="muted">→ @esc.Resolution</span> }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (sa.CollectedInfo.Count > 0)
                                {
                                    <div class="sa-section">
                                        <h4>Toplanan bilgiler</h4>
                                        @foreach (var kvp in sa.CollectedInfo)
                                        {
                                            <div class="sa-info-row">
                                                <span class="sa-info-key">@kvp.Key</span>
                                                <span>@kvp.Value</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                </div>
            </div>
        </section>

        <!-- TAB: HISTORY -->
        <section id="panel-history" class="tab-content @ActiveCls("history")" role="tabpanel" aria-labelledby="tab-history">
            @if (_stuckApprovals.Count > 0)
            {
                <h3 class="warn-heading"><Icon Name="alert" /> Yürütmesi askıda kalan onaylar (@_stuckApprovals.Count)</h3>
                <div class="cards-list">
                    <div class="empty-state">
                        Bu talepler onaylandı ve işlem <strong>başlatıldı</strong>, ancak sonucu hiç yazılmadı —
                        büyük olasılıkla yürütme sırasında süreç kapandı (deploy/crash). İşlemin gerçekten
                        yapılıp yapılmadığı <strong>elle doğrulanmalıdır</strong>; sistem otomatik tekrar denemez.
                    </div>
                    @foreach (var a in _stuckApprovals)
                    {
                        <article class="card card-history">
                            <header class="card-header">
                                <div class="card-title">
                                    <span class="tool-tag" title="@a.ToolName">@ToolDisplayName(a.ToolName)</span>
                                    <span class="status-tag pending">işlem askıda</span>
                                    <code class="card-id">@ShortId(a.Id)</code>
                                </div>
                                <time class="muted">@FmtRelative(a.RequestedAt)</time>
                            </header>
                            <div class="card-body">
                                <div class="card-row"><span class="label">Müşteri:</span> <span>@(a.CustomerName ?? a.CustomerId ?? "—")</span></div>
                                <div class="card-row"><span class="label">Karar:</span> <span>@a.DecidedBy · @a.DecisionReason</span></div>
                            </div>
                        </article>
                    }
                </div>
            }

            <h3 class="section-spaced">Onay kararları</h3>
            <div class="cards-list">
                @if (_historyApprovals.Count == 0) { <div class="empty-state">Henüz karar kaydı yok.</div> }
                else
                {
                    @foreach (var a in _historyApprovals)
                    {
                        <article class="card card-history">
                            <header class="card-header">
                                <div class="card-title"><span class="tool-tag" title="@a.ToolName">@ToolDisplayName(a.ToolName)</span><span class="status-tag @a.Status">@DecisionLabel(a.Status)</span>@if (a.ExecutionStatus is "running" or "failed")
                                    {
                                        <span class="status-tag @(a.ExecutionStatus == "failed" ? "rejected" : "pending")">@ExecutionStatusLabel(a.ExecutionStatus, IsStuck(a))</span>
                                    }<code class="card-id">@ShortId(a.Id)</code></div>
                                <time class="muted">@FmtRelative(a.RequestedAt)</time>
                            </header>
                            @if (a.DecidedBy is not null)
                            {
                                <div class="card-body"><div class="card-row"><span class="label">Karar:</span> <span>@a.DecidedBy · @a.DecisionReason</span></div></div>
                            }
                            @if (a.ExecutionStatus == "running" && IsStuck(a))
                            {
                                <div class="card-body"><div class="card-row"><span class="label">Dikkat:</span> <span>Onaylandı ve işlem başlatıldı, ancak sonucu hiç yazılmadı — büyük olasılıkla yürütme sırasında süreç kapandı (deploy/crash). İşlemin gerçekten yapılıp yapılmadığı <strong>elle doğrulanmalıdır</strong>; sistem bunu kendiliğinden tekrar denemez.</span></div></div>
                            }
                            else if (a.ExecutionStatus == "failed")
                            {
                                <div class="card-body"><div class="card-row"><span class="label">Yürütme hatası:</span> <span>@(a.ExecutionResult ?? "bilinmiyor")</span></div></div>
                            }
                        </article>
                    }
                }
            </div>
            <h3 class="section-spaced">Eskalasyonlar</h3>
            <div class="cards-list">
                @if (_historyEscalations.Count == 0) { <div class="empty-state">Henüz eskalasyon yok.</div> }
                else
                {
                    @foreach (var e in _historyEscalations)
                    {
                        <article class="card card-history">
                            <header class="card-header">
                                <div class="card-title"><span class="status-tag @e.Status">@EscalationStatusLabel(e.Status)</span><code class="card-id">@ShortId(e.Id)</code></div>
                                <time class="muted">@FmtRelative(e.CreatedAt)</time>
                            </header>
                            <div class="card-body">
                                <div class="card-row"><span class="label">Asistan:</span> <span title="@e.AgentName">@AgentDisplayName(e.AgentName)</span></div>
                                @if (e.Resolution is not null) { <div class="card-row"><span class="label">Çözüm:</span> <span>@e.Resolution</span></div> }
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <!-- TAB: IMPROVEMENTS -->
        <section id="panel-improvements" class="tab-content @ActiveCls("improvements")" role="tabpanel" aria-labelledby="tab-improvements">
            <div class="section-toolbar">
                <button class="btn-primary" @onclick="MineImprovementsAsync" disabled="@_miningInProgress">
                    <Icon Name="sparkles" /> @(_miningInProgress ? "Taranıyor…" : "Yeni tarama çalıştır")
                </button>
            </div>
            @if (_miningStats is not null) { <p class="muted" style="margin-bottom:12px;">@_miningStats</p> }
            <h3>Onay bekleyen öneriler</h3>
            <div class="cards-list">
                @if (_proposedLessons.Count == 0) { <div class="empty-state">Henüz öneri yok. "Yeni tarama çalıştır" ile başlatın.</div> }
                else
                {
                    @foreach (var l in _proposedLessons)
                    {
                        <article class="card">
                            <header class="card-header">
                                <div class="card-title"><strong>@(l.Title ?? "(başlıksız)")</strong>@if (l.SuggestedAgent is not null) { <span class="badge">@l.SuggestedAgent</span> }</div>
                                <code class="card-id">@ShortId(l.Id)</code>
                            </header>
                            <div class="card-body">
                                <p style="margin:8px 0">@l.LessonText</p>
                                @if (l.Observation is not null) { <p class="muted small"><em>Gözlem:</em> @l.Observation</p> }
                                @if (l.SourceTraceIds is { Length: > 0 } ids)
                                {
                                    <p class="muted small">Kaynak izler:
                                        @foreach (var tid in ids.Take(3))
                                        {
                                            <a href="/replay?traceId=@Uri.EscapeDataString(tid)" target="_blank"><code>@tid[..Math.Min(8, tid.Length)]</code></a>@(" ")
                                        }
                                        @if (ids.Length > 3) { <span>(+@(ids.Length - 3))</span> }
                                    </p>
                                }
                            </div>
                            <footer class="card-footer">
                                <button class="btn-danger"  @onclick='() => ShowPrompt(PromptKind.RejectLesson,  l.Id, "Dersi reddet", "Red sebebi (isteğe bağlı)")'><Icon Name="x" StrokeWidth="2.2" /> Reddet</button>
                                <button class="btn-primary" @onclick='() => ShowPrompt(PromptKind.ApproveLesson, l.Id, "Dersi onayla", "Not (isteğe bağlı)")'><Icon Name="check" StrokeWidth="2.2" /> Onayla</button>
                            </footer>
                        </article>
                    }
                }
            </div>
            <h3 class="section-spaced">Onaylanmış dersler</h3>
            <div class="cards-list">
                @if (_approvedLessons.Count == 0) { <div class="empty-state">Henüz onaylanmış ders yok.</div> }
                else
                {
                    @foreach (var l in _approvedLessons)
                    {
                        <article class="card">
                            <header class="card-header">
                                <div class="card-title"><strong>@(l.Title ?? "(başlıksız)")</strong>@if (l.SuggestedAgent is not null) { <span class="badge">@l.SuggestedAgent</span> }</div>
                                <code class="card-id">@ShortId(l.Id)</code>
                            </header>
                            <div class="card-body">
                                <p style="margin:8px 0">@l.LessonText</p>
                                @if (l.Observation is not null) { <p class="muted small"><em>Gözlem:</em> @l.Observation</p> }
                                @if (l.DecidedBy is not null)
                                {
                                    <p class="muted small">
                                        @LessonStatusLabel(l.Status) · @l.DecidedBy
                                        @if (l.DecidedAt is not null) { <span> · @l.DecidedAt.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span> }
                                        @if (l.DecisionReason is not null) { <span> · @l.DecisionReason</span> }
                                    </p>
                                }
                                @* Onaylı ama vektör hafızaya yazılamamış ders sessizce etkisiz kalır —
                                   yalnızca DB'de durur, konuşmalara context olarak hiç girmez. *@
                                @if (l.Status == "Approved" && string.IsNullOrEmpty(l.VectorMemoryId))
                                {
                                    <div class="lesson-inactive">
                                        <span><Icon Name="alert" Size="14" /> Onaylandı ama hafızaya yazılamadı — bu ders şu anda <strong>etkisiz</strong>.</span>
                                        <button class="btn-secondary btn-sm" @onclick="() => RetryLessonMemoryAsync(l.Id)">
                                            Hafızaya yeniden yaz
                                        </button>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

    </main>
</div>

<!-- SESLİ GÖRÜŞME KAYDI -->
@if (_playerCall is { } pc)
{
    <VoiceCallPlayer CallId="@pc.CallId" StartOffsetMs="@pc.OffsetMs" OnClose="() => _playerCall = null" />
}

<!-- PROMPT MODAL -->
@if (_showPromptModal)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="prompt-modal-title"
         @onclick="CancelPrompt" @onkeydown="OnModalKeyDown">
        <div class="modal modal-prompt" @onclick:stopPropagation>
            <header class="modal-header">
                <h3 id="prompt-modal-title">@_promptTitle</h3>
                <button type="button" class="btn-icon" @onclick="CancelPrompt" aria-label="Kapat"><Icon Name="x" Size="18" /></button>
            </header>
            <div class="modal-body modal-prompt-body">
                <label class="form-label">@_promptLabel</label>
                <textarea class="form-control" rows="3" maxlength="500" @bind="_promptInput"></textarea>
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="CancelPrompt">İptal</button>
                <button type="button" class="btn-primary"   @onclick="ConfirmPromptAsync"
                        disabled="@(_promptRequired && string.IsNullOrWhiteSpace(_promptInput))">Onayla</button>
            </footer>
        </div>
    </div>
}

<!-- CLOSE CHAT MODAL (kapanış nedeni / etiketler / not) -->
@if (_showCloseModal)
{
    var requireReason = _closeOptions?.RequireReason ?? false;
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="close-modal-title"
         @onclick="() => { if (!_closing) _showCloseModal = false; }" @onkeydown="OnModalKeyDown">
        <div class="modal modal-prompt" @onclick:stopPropagation>
            <header class="modal-header">
                <h3 id="close-modal-title">Sohbeti Bitir</h3>
                <button type="button" class="btn-icon" @onclick="() => _showCloseModal = false" disabled="@_closing" aria-label="Kapat"><Icon Name="x" Size="18" /></button>
            </header>
            <div class="modal-body modal-prompt-body close-chat-form">
                <label class="form-label" for="close-reason">Kapanış nedeni@(requireReason ? " *" : "")</label>
                <select id="close-reason" class="form-control" @bind="_closeReason" aria-required="@(requireReason ? "true" : "false")">
                    <option value="">— Seçin —</option>
                    @foreach (var r in _closeOptions?.Reasons ?? [])
                    {
                        <option value="@r.Code">@r.Label</option>
                    }
                </select>

                <label class="form-label" for="close-tags">Etiketler <span class="muted small">(virgülle ayırın, en fazla 10)</span></label>
                <input id="close-tags" type="text" class="form-control" placeholder="ör. kargo, iade"
                       @bind="_closeTags" @bind:event="oninput" />
                @if (_closeOptions is { SuggestedTags.Length: > 0 })
                {
                    <div class="close-tag-suggestions" aria-label="Sık kullanılan etiketler">
                        @foreach (var t in _closeOptions.SuggestedTags)
                        {
                            <button type="button" class="tag-chip" @onclick="() => AddSuggestedTag(t)">+ @t</button>
                        }
                    </div>
                }

                <label class="form-label" for="close-note">Not <span class="muted small">(isteğe bağlı)</span></label>
                <textarea id="close-note" class="form-control" rows="3" maxlength="1000"
                          @bind="_closeNote" @bind:event="oninput"></textarea>

                @if (_closeError is not null)
                {
                    <p class="form-error" role="alert">@_closeError</p>
                }
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _showCloseModal = false" disabled="@_closing">İptal</button>
                <button type="button" class="btn-danger" @onclick="ConfirmCloseAsync"
                        disabled="@(_closing || (requireReason && string.IsNullOrEmpty(_closeReason)))">
                    @(_closing ? "Kapatılıyor…" : "Sohbeti bitir")
                </button>
            </footer>
        </div>
    </div>
}

<!-- ASSIGN MODAL -->
@if (_showAssignModal)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="assign-modal-title"
         @onclick="() => _showAssignModal = false" @onkeydown="OnModalKeyDown">
        <div class="modal modal-prompt" @onclick:stopPropagation>
            <header class="modal-header">
                <h3 id="assign-modal-title">Temsilciye ata</h3>
                <button type="button" class="btn-icon" @onclick="() => _showAssignModal = false" aria-label="Kapat"><Icon Name="x" Size="18" /></button>
            </header>
            <div class="modal-body modal-prompt-body">
                <label class="form-label">Temsilci seç</label>
                @if (_assignAgents.Count > 0)
                {
                    <select class="form-control" @bind="_assignSelected">
                        @foreach (var a in _assignAgents)
                        {
                            var presence = PresenceOf(a.Id);
                            <option value="@a.Id" disabled="@(!a.IsActive)">
                                @a.DisplayName — @a.Id@(!a.IsActive ? " (pasif)" : "")@(presence is not null ? $" · {PresenceLabel(presence.Presence)}" : "")
                            </option>
                        }
                    </select>
                    <p class="muted small" style="margin-top:6px">Müşteri, seçilen temsilcinin üstlendiğini bilgilendirilir.</p>
                }
                else
                {
                    <input type="text" class="form-control" placeholder="Ör. agent-jdoe"
                           @bind="_assignFallbackText" @bind:event="oninput" />
                    <p class="muted small" style="margin-top:6px">Kayıtlı temsilci bulunamadı. Temsilci ID'sini elle girin.</p>
                }
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _showAssignModal = false">İptal</button>
                <button type="button" class="btn-primary"   @onclick="ConfirmAssignAsync"
                        disabled="@(_assignAgents.Count == 0 && string.IsNullOrWhiteSpace(_assignFallbackText))">
                    Ata
                </button>
            </footer>
        </div>
    </div>
}

<!-- TRANSCRIPT MODAL -->
@if (_showTranscriptModal)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="transcript-modal-title"
         @onclick="() => _showTranscriptModal = false" @onkeydown="OnModalKeyDown">
        <div class="modal" @onclick:stopPropagation>
            <header class="modal-header">
                <div><h3 id="transcript-modal-title">Konuşma geçmişi</h3><p class="muted small">@_transcriptSubtitle</p></div>
                <button class="btn-icon" @onclick="() => _showTranscriptModal = false" aria-label="Kapat"><Icon Name="x" Size="18" /></button>
            </header>
            <div class="modal-body">
                <div class="chat-panel-messages">
                    @if (_transcriptMessages.Count == 0) { <div class="empty-state">Yükleniyor…</div> }
                    @foreach (var m in _transcriptMessages)
                    {
                        @if (m.Sender.Equals("system", StringComparison.OrdinalIgnoreCase) && m.Text.StartsWith("📋"))
                        {
                            var noteText = m.Text.StartsWith("📋 Temsilci yeniden planlama notu: ")
                                ? m.Text["📋 Temsilci yeniden planlama notu: ".Length..].Trim('"')
                                : m.Text[2..].Trim();
                            <div class="internal-note">
                                <div class="internal-note-header">
                                    <span class="internal-note-badge">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                                        </svg>
                                        Temsilci Notu
                                    </span>
                                    <span class="internal-note-time">@FmtTs(m.Timestamp)</span>
                                </div>
                                <p class="internal-note-body">@noteText</p>
                            </div>
                        }
                        else
                        {
                            <div class="chat-bubble @(m.Sender.ToLowerInvariant())">
                                @m.Text
                                <span class="chat-bubble-meta">@FmtTs(m.Timestamp)</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    // RenderFragment helpers — Razor template syntax requires these to live in .razor file

    /// <summary>Harcama / limit; %80'de uyarı, %100'de dolu rengi. Limit 0 = sınırsız (çubuk yok).</summary>
    private RenderFragment RenderBudget(string label, decimal spent, decimal limit)
    {
        var pct = limit > 0 ? (int)Math.Min(100, Math.Round(spent * 100 / limit)) : 0;
        var level = limit <= 0 ? "" : pct >= 100 ? "budget-full" : pct >= 80 ? "budget-warn" : "budget-ok";
        return @<div class="analytics-card llm-budget-card @level" title="@(limit > 0 ? $"%{pct}" : "Sınırsız")">
            <div class="analytics-card-data">
                <div class="analytics-card-value">@FormatUsd(spent)@(limit > 0 ? $" / {FormatUsd(limit)}" : "")</div>
                <div class="analytics-card-label">@label@(limit > 0 ? "" : " (limit yok)")</div>
                @if (limit > 0)
                {
                    <div class="budget-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct" aria-label="@label">
                        <div class="budget-fill" style="width:@(pct)%"></div>
                    </div>
                }
            </div>
        </div>;
    }

    private RenderFragment RenderDist(string title, Dictionary<string, int>? dist)
    {
        if (dist is null || dist.Count == 0)
            return @<div class="analytics-chart-card"><h3>@title</h3><div class="empty-state" style="padding:12px">Veri yok.</div></div>;

        var total  = dist.Values.Sum();
        var sorted = dist.OrderByDescending(x => x.Value).ToList();
        return @<div class="analytics-chart-card">
            <h3>@title</h3>
            @foreach (var kvp in sorted)
            {
                var pct = total > 0 ? (int)Math.Round(kvp.Value * 100.0 / total) : 0;
                <div class="dist-bar-row">
                    <div class="dist-bar-label">@kvp.Key</div>
                    <div class="dist-bar-track">
                        <div class="dist-bar-fill" style="width:@(pct)%"></div>
                    </div>
                    <div class="dist-bar-count">@kvp.Value (@(pct)%)</div>
                </div>
            }
        </div>;
    }

    private static RenderFragment RenderRatingDistribution(Dictionary<string, int>? dist, int total)
    {
        if (dist is null || total == 0)
            return @<div class="analytics-chart-card"><h3>Puan Dağılımı</h3><div class="empty-state" style="padding:12px">Henüz değerlendirme yok.</div></div>;

        var colors = new Dictionary<string, string> { ["1"]="#ef4444",["2"]="#f97316",["3"]="#eab308",["4"]="#22c55e",["5"]="#10b981" };
        var labels = new Dictionary<string, string> { ["1"]="Çok Kötü",["2"]="Kötü",["3"]="Orta",["4"]="İyi",["5"]="Mükemmel" };
        return @<div class="analytics-chart-card">
            <h3>Puan Dağılımı</h3>
            @foreach (var star in new[] { "5","4","3","2","1" })
            {
                var cnt = dist.TryGetValue(star, out var c) ? c : 0;
                var pct = total > 0 ? (int)Math.Round(cnt * 100.0 / total) : 0;
                <div class="rating-bar-row">
                    <span class="rating-bar-label">@star ★ <small>@labels.GetValueOrDefault(star,star)</small></span>
                    <div class="rating-bar-track">
                        <div class="rating-bar-fill" style="width:@(pct)%;background:@colors.GetValueOrDefault(star,"#6366f1")"></div>
                    </div>
                    <span class="rating-bar-count">@cnt</span>
                </div>
            }
        </div>;
    }

    /// <summary>Dolar tutarı: 1$ altı (görüşme başı maliyet) 4 ondalık, üstü 2 ondalık.</summary>
    private static string FormatUsd(decimal usd) =>
        usd >= 1m ? usd.ToString("$#,0.00", System.Globalization.CultureInfo.InvariantCulture)
                   : usd.ToString("$0.0000", System.Globalization.CultureInfo.InvariantCulture);

    private static RenderFragment RenderApprovalStats(ApprovalStats? stats)
    {
        if (stats is null || stats.Total == 0)
            return @<div class="analytics-chart-card"><h3>Onay İstatistikleri</h3><div class="empty-state" style="padding:12px">Henüz onay işlemi yok.</div></div>;

        return @<div class="analytics-chart-card">
            <h3>Onay İstatistikleri</h3>
            <div class="stat-pills">
                <div class="stat-pill approved"><span class="stat-pill-value">@stats.Approved</span><span class="stat-pill-label">Onaylandı</span></div>
                <div class="stat-pill rejected"><span class="stat-pill-value">@stats.Rejected</span><span class="stat-pill-label">Reddedildi</span></div>
                <div class="stat-pill expired"><span class="stat-pill-value">@stats.TimedOut</span><span class="stat-pill-label">Zaman aşımı</span></div>
            </div>
            <div class="stat-total">Toplam: @stats.Total</div>
        </div>;
    }

    private static RenderFragment RenderEscalationStats(EscalationStats? stats)
    {
        if (stats is null || stats.Total == 0)
            return @<div class="analytics-chart-card"><h3>Eskalasyon İstatistikleri</h3><div class="empty-state" style="padding:12px">Henüz eskalasyon yok.</div></div>;

        return @<div class="analytics-chart-card">
            <h3>Eskalasyon İstatistikleri</h3>
            <div class="stat-pills">
                <div class="stat-pill resolved"><span class="stat-pill-value">@stats.Resolved</span><span class="stat-pill-label">Çözüldü</span></div>
                <div class="stat-pill dismissed"><span class="stat-pill-value">@stats.Dismissed</span><span class="stat-pill-label">Kapatıldı</span></div>
            </div>
            <div class="stat-total">Toplam: @stats.Total</div>
        </div>;
    }

    private static RenderFragment RenderRecentRatings(RecentRating[]? ratings)
    {
        if (ratings is null || ratings.Length == 0)
            return @<div class="analytics-chart-card"><h3>Son Değerlendirmeler</h3><div class="empty-state" style="padding:12px">Henüz değerlendirme yok.</div></div>;

        var ratingLabels = new Dictionary<int, string> { [1]="Çok Kötü",[2]="Kötü",[3]="Orta",[4]="İyi",[5]="Mükemmel" };
        return @<div class="analytics-chart-card">
            <h3>Son Değerlendirmeler</h3>
            @foreach (var r in ratings)
            {
                <div class="recent-rating-item">
                    <div class="recent-rating-header">
                        <span class="recent-rating-stars">@(new string('★', r.Stars))@(new string('☆', 5 - r.Stars))</span>
                        <span class="recent-rating-label">@ratingLabels.GetValueOrDefault(r.Stars, "")</span>
                        <time class="muted">@FmtRelative(r.RatedAt)</time>
                    </div>
                    <div class="recent-rating-session"><code>@ShortId(r.SessionId)</code></div>
                    @if (r.Feedback is not null) { <div class="recent-rating-feedback">@r.Feedback</div> }
                </div>
            }
        </div>;
    }
}

