@page "/"
@attribute [Authorize(Roles = "Customer")]
@layout EmptyLayout
@inject IJSRuntime JS
@inject ChatApiService ChatApi
@inject HttpClient Http
@inject AuthTokenStore TokenStore
@inject AuthService AuthSvc
@inject AppAuthStateProvider AuthState
@inject NavigationManager Nav
@implements IAsyncDisposable
@inject ThemeService ThemeSvc
@using System.Text.Json
@using Markdig

<div class="app-layout">
    <div class="chat-panel">

        <!-- HEADER -->
        <header class="chat-header">
            <div class="header-left">
                <div class="header-avatar">
                    <img src="images/chatbot.png" alt="Asistan" />
                </div>
                <div class="header-info">
                    <h1>Müşteri Destek Asistanı</h1>
                    <div class="header-status">
                        <span class="status-dot @(_humanMode ? "human" : "")"></span>
                        <span>@(_humanMode ? $"Temsilci: {_humanAgent}" : "Çevrimiçi")</span>
                    </div>
                </div>
            </div>
            <div class="header-right">
                <div class="approval-notifications">
                    <button type="button" class="btn-approval-bell" @onclick="ToggleApprovalPanelAsync"
                            aria-label="Onay bildirimleri" title="Onay bildirimleri">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        @if (_approvalNotifications.Count > 0)
                        {
                            <span class="badge badge-warn approval-badge">@_approvalNotifications.Count</span>
                        }
                    </button>
                    @if (_showApprovalPanel)
                    {
                        <div class="approval-panel">
                            @if (_showFullHistory)
                            {
                                <div class="approval-panel-header">
                                    <button type="button" class="approval-panel-back" @onclick="() => _showFullHistory = false">← Geri</button>
                                    <span>Geçmiş işlemlerim</span>
                                </div>
                                @if (_historyLoading)
                                {
                                    <div class="approval-panel-empty">Yükleniyor…</div>
                                }
                                else if (_approvalHistory.Count == 0)
                                {
                                    <div class="approval-panel-empty">Henüz onay gerektiren bir işlem yapmadınız.</div>
                                }
                                else
                                {
                                    @foreach (var a in _approvalHistory)
                                    {
                                        <div class="approval-panel-item approval-@a.Status">
                                            <span class="approval-status">@ApprovalStatusLabel(a.Status)</span>
                                            <span class="approval-message">@(a.ExecutionResult ?? a.DecisionReason ?? "")</span>
                                            <span class="approval-date">@a.RequestedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                @if (CurrentApprovalList.Count == 0)
                                {
                                    <div class="approval-panel-empty">Henüz bir onay sonucu yok.</div>
                                }
                                else
                                {
                                    @foreach (var a in CurrentApprovalList)
                                    {
                                        <div class="approval-panel-item approval-@a.Status">
                                            <span class="approval-status">@ApprovalStatusLabel(a.Status)</span>
                                            <span class="approval-message">@(a.ExecutionResult ?? a.DecisionReason ?? "")</span>
                                        </div>
                                    }
                                }
                                <button type="button" class="approval-panel-history-link" @onclick="ToggleFullHistoryAsync">
                                    Tüm geçmişi gör →
                                </button>
                            }
                        </div>
                    }
                </div>
                <button type="button" class="btn-theme-toggle" @onclick="ToggleThemeAsync"
                        aria-label="@(ThemeSvc.IsDark ? "Aydınlık moda geç" : "Karanlık moda geç")"
                        title="@(ThemeSvc.IsDark ? "Aydınlık mod" : "Karanlık mod")">
                    @if (ThemeSvc.IsDark)
                    {
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="5"/>
                            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                        </svg>
                    }
                    else
                    {
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </svg>
                    }
                </button>
                @if (_messages.Count > 0)
                {
                    <button class="btn-new-chat" @onclick="NewChatAsync" title="Yeni sohbet">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                        Yeni Sohbet
                    </button>
                }
            </div>
        </header>

        <!-- MESAJLAR -->
        <main class="messages" id="messages">
            @if (_messages.Count == 0)
            {
                <div class="welcome" id="welcome">
                    <div class="welcome-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" />
                        </svg>
                    </div>
                    <h2>@WelcomeTitle</h2>
                    <p>Size nasıl yardımcı olabilirim? Aşağıdaki konulardan birini seçebilir veya doğrudan sorunuzu yazabilirsiniz.</p>
                    <div class="examples">
                        <button class="example-chip" @onclick='() => SendChipMessage("Satışta olan ürünleri görmek istiyorum")'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            Ürün bilgisi
                        </button>
                        <button class="example-chip" @onclick='() => SendChipMessage("Sipariş vermek istiyorum")'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                            Sipariş ver
                        </button>
                        <button class="example-chip" @onclick='() => SendChipMessage("Siparişimin durumunu sorgulamak istiyorum")'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/><path d="m7.5 4.27 9 5.15"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" x2="12" y1="22" y2="12"/><path d="m17 13 5 5m-5 0 5-5"/></svg>
                            Sipariş durumu
                        </button>
                        <button class="example-chip" @onclick='() => SendChipMessage("Siparişimle ilgili şikayette bulunmak istiyorum")'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Şikayet bildirimi
                        </button>
                    </div>

                    @* Açılış bildirimi: kullanıcı ilk mesajını yazmadan ÖNCE görsün.
                       Composer altındaki kalıcı satır tekrar değil tamamlayıcıdır — orası
                       küçük ve göz alışkanlığıyla silikleşir, burası ise ilk temas noktası. *@
                    <p class="welcome-ai-notice">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
                        </svg>
                        <span>
                            Bu asistan yapay zekâ ile çalışır. Yanıtlar hatalı veya eksik olabilir;
                            sipariş, iptal ve iade gibi işlemlerde bilgileri doğrulamanızı öneririz.
                        </span>
                    </p>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    @if (msg.Role == "user")
                    {
                        <div class="message user">
                            <div class="message-avatar">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="message-content">
                                <div class="message-bubble">@msg.Content</div>
                            </div>
                        </div>
                    }
                    else if (msg.Role is "assistant" or "agent")
                    {
                        <div class="message bot @(msg.IsStreaming ? "streaming" : "")">
                            <div class="message-avatar">
                                <img class="avatar-img" src="images/chatbot.png" alt="Bot" />
                            </div>
                            <div class="message-content">
                                @if (msg.IsStreaming && _agentChips.Count > 0)
                                {
                                    <div class="agent-chip-list">
                                        @foreach (var chip in _agentChips.OrderBy(c => c.SortOrder))
                                        {
                                            <div class="agent-chip @(chip.Status == "done" ? "done" : "running")">
                                                @if (chip.Status == "done")
                                                {
                                                    <span class="agent-chip-check">✓</span>
                                                }
                                                else
                                                {
                                                    <span class="agent-chip-dot"></span>
                                                }
                                                <span class="agent-chip-text">@FriendlyAgentName(chip.Name) @(chip.Status == "done" ? "tamamlandı" : "çalışıyor…")</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (msg.ProcessedAgents is { Count: > 0 })
                                {
                                    <!-- Canlı çipler yerini bu dondurulmuş (hepsi "tamamlandı") kopyaya
                                         bırakır — kullanıcı hangi ajanların çalıştığını yanıt bittikten
                                         sonra da görsün diye kaybolmuyor.

                                         Koşulda `!msg.IsStreaming` ARANMAZ: snapshot response_start'ta
                                         alınıp canlı liste aynı anda temizleniyor, ama IsStreaming yanıt
                                         akışı boyunca true kalıyor. Bu bayrak burada da aransaydı iki dal
                                         da false olur, panel yanıt akarken kaybolup response_complete'te
                                         yeniden belirirdi (kullanıcının bildirdiği titreme). -->

                                    <div class="agent-chip-list">
                                        @foreach (var agentName in msg.ProcessedAgents)
                                        {
                                            <div class="agent-chip done">
                                                <span class="agent-chip-check">✓</span>
                                                <span class="agent-chip-text">@agentName tamamlandı</span>
                                            </div>
                                        }
                                    </div>
                                }
                        @if (!string.IsNullOrEmpty(msg.ReasoningText) || msg.ReasoningData.HasValue)
                                {
                                    <details class="reasoning-panel @(msg.IsStreaming ? "streaming" : "")" open>
                                        <summary class="reasoning-summary">
                                            <span class="reasoning-icon">🧠</span>
                                            <span class="reasoning-label">Düşünce süreci</span>
                                            @if (msg.IsStreaming)
                                            {
                                                <span class="reasoning-dots inline"><span></span><span></span><span></span></span>
                                            }
                                            else if (msg.ReasoningData.HasValue)
                                            {
                                                <span class="reasoning-badge">@(GetJsonString(msg.ReasoningData.Value, "confidence") ?? "orta")</span>
                                            }
                                            <span class="reasoning-chevron">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                                            </span>
                                        </summary>
                                        <div class="reasoning-body">
                                            @if (msg.ReasoningData.HasValue)
                                            {
                                                @RenderReasoningBody(msg.ReasoningData.Value)
                                            }
                                            else
                                            {
                                                @* reasoning_complete gelmemiş (akış sürüyor ya da tur yarıda
                                                   kaldı). HER İKİ durumda da yalnızca analysis alanı gösterilir —
                                                   eskiden akış bittiği hâlde ReasoningData boşsa ham JSON olduğu
                                                   gibi ekrana basılıyordu; canlıda eşzamanlı iki tur çakışınca
                                                   kullanıcı yarım kesilmiş JSON metni gördü. *@
                                                var partial = ExtractAnalysisFromPartialJson(msg.ReasoningText);
                                                @if (!string.IsNullOrWhiteSpace(partial))
                                                {
                                                    <div class="reasoning-section-text">@partial</div>
                                                }
                                                else if (!msg.IsStreaming)
                                                {
                                                    <div class="reasoning-section-text muted">Düşünce süreci tamamlanamadı.</div>
                                                }
                                            }
                                        </div>
                                    </details>
                                }
                                else if (msg.IsStreaming && string.IsNullOrEmpty(msg.Content))
                                {
                                    <div class="reasoning-pending">
                                        <span>🧠 Düşünüyor</span>
                                        <span class="reasoning-dots"><span></span><span></span><span></span></span>
                                    </div>
                                }
                                @* Balon, ilk token gelene kadar RENDER EDİLMEZ: aksi halde yanıt
                                   beklenirken içi boş, yalnızca imleç barındıran beyaz bir kutu
                                   görünüyordu — üstelik hemen üstündeki "🧠 Düşünüyor …" göstergesi
                                   zaten aynı durumu anlatıyor, ikisi birden çakışıyordu. Akış
                                   bittiğinde (içerik boş kalsa bile) balon eskisi gibi çizilir. *@
                                @if (!msg.IsStreaming || !string.IsNullOrEmpty(msg.Content))
                                {
                                    <div class="message-bubble @(msg.IsStreaming ? "streaming-bubble" : "md")">
                                        @if (msg.IsStreaming)
                                        {
                                            <span class="streaming-text">@msg.Content</span><span class="streaming-cursor"></span>
                                        }
                                        else
                                        {
                                            @RenderMd(msg.Content)
                                        }
                                    </div>
                                }
                                @* Picker, ipucu geldiği anda DEĞİL tur bittiğinde çizilir.
                                   category_picker tool çalışırken yayınlanıyor (bkz.
                                   ProductToolsService.ShowCategoryPicker), yani veri turun
                                   ortasında geliyor; ResponseAgent hâlâ metin üretiyor olabilir.
                                   Erken çizilirse kullanıcı, sistem çalışırken tıklanabilir bir
                                   arayüz görüyor ve tıklarsa ikinci bir tur başlıyordu. Veri
                                   erken gelmeye devam ediyor, yalnızca gösterimi erteleniyor. *@
                                @if (!msg.IsStreaming && msg.CategoryPicker is { Count: > 0 })
                                {
                                    <div class="category-picker">
                                        <span class="category-picker-label">Kategori seçin</span>
                                        <div class="category-picker-grid">
                                            @foreach (var cat in msg.CategoryPicker)
                                            {
                                                var catCapture = cat;
                                                <button class="category-card"
                                                        @onclick='() => SendChipMessage($"{catCapture} kategorisindeki ürünleri göster")'
                                                        aria-label="@catCapture kategorisini seç">
                                                    <span class="category-card-icon">@GetCategoryIcon(catCapture)</span>
                                                    <span class="category-card-name">@catCapture</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (msg.Role == "human")
                    {
                        <div class="message human">
                            <div class="message-avatar">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <div class="message-content">
                                @if (!string.IsNullOrEmpty(_humanAgent))
                                {
                                    <div class="human-agent-label">@_humanAgent</div>
                                }
                                <div class="message-bubble human-bubble">@msg.Content</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="system-notice">@msg.Content</div>
                    }
                }
                @if (_showTypingIndicator)
                {
                    <div class="message bot">
                        <div class="message-avatar">
                            <img class="avatar-img" src="images/chatbot.png" alt="Bot" />
                        </div>
                        <div class="message-bubble">
                            <div class="typing-indicator"><span></span><span></span><span></span></div>
                        </div>
                    </div>
                }
            }
        </main>

        <!-- PENDING HANDOFF BANNER -->
        @if (_pendingHandoff && !_humanMode)
        {
            <div class="human-mode-banner pending">
                <span class="dot-pending"></span>
                <span class="pending-text">
                    <strong>Bir müşteri temsilcisi bağlanıyor…</strong>
                    Lütfen yanıt gelene kadar bekleyin.
                    @if (!string.IsNullOrWhiteSpace(_pendingHandoffReason))
                    {
                        <span class="pending-reason" title="@_pendingHandoffReason">@_pendingHandoffReason</span>
                    }
                </span>
                <button class="btn-cancel-pending" @onclick="CancelPendingHandoff" title="Beklemekten vazgeç">
                    Vazgeç
                </button>
            </div>
        }

        <!-- HUMAN MODE BANNER -->
        @if (_humanMode)
        {
            <div class="human-mode-banner">
                <span class="dot-live"></span>
                <strong>@(_humanAgent ?? "Müşteri temsilcisi")</strong> şu an sohbette.
                Bot yerine size <em>insan</em> bir temsilci yanıt veriyor.
            </div>
        }

        <!-- RATING -->
        @if (_showRating && !_ratingSubmitted)
        {
            <div class="rating-widget" @onmouseenter="ClearRatingAutoHideTimer" @onmouseleave="StartRatingAutoHideTimer">
                <div class="rating-widget-inner">
                    <div class="rating-widget-header">
                        <span class="rating-widget-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </span>
                        <span>Bu sohbeti nasıl buldunuz?</span>
                    </div>
                    <div class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var star = i;
                            var isLit = (_hoverRating ?? _selectedRating ?? 0) >= star;
                            <button class="rating-star @(isLit ? "active" : "")"
                                    @onclick="() => _selectedRating = star"
                                    @onmouseenter="() => _hoverRating = star"
                                    @onmouseleave="() => _hoverRating = null">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="@(isLit ? "currentColor" : "none")" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            </button>
                        }
                    </div>
                    @{
                        var displayRating = _hoverRating ?? _selectedRating;
                    }
                    <div class="rating-label">@(displayRating switch { 1 => "Çok kötü", 2 => "Kötü", 3 => "Orta", 4 => "İyi", 5 => "Harika!", _ => "" })</div>
                    @if (_selectedRating.HasValue)
                    {
                        <textarea class="rating-feedback" rows="2" placeholder="Yorumunuz (isteğe bağlı)" @bind="_ratingFeedback"></textarea>
                        <div class="rating-actions">
                            <button class="rating-submit" @onclick="SubmitRatingAsync">Gönder</button>
                            <button class="rating-skip" @onclick="() => { _showRating = false; _ratingSubmitted = true; }">Daha sonra</button>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- INPUT ALANI -->
        <footer class="input-area">
            <div class="input-wrapper">
                <input type="text"
                       id="userInput"
                       placeholder="@(_pendingHandoff && !_humanMode ? "Temsilci bağlanana kadar lütfen bekleyin…" : "Bir mesaj yazın...")"
                       autocomplete="off"
                       @bind="_input"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@(_isStreaming || (_pendingHandoff && !_humanMode))" />
                <button id="voiceBtn" title="Sesli Asistan (tam pipeline)" aria-label="Sesli konuşmayı başlat" class="btn-voice">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="9" y="2" width="6" height="12" rx="3"/>
                        <path d="M5 10v2a7 7 0 0 0 14 0v-2"/>
                        <line x1="12" y1="19" x2="12" y2="22"/>
                    </svg>
                </button>
                <button id="voiceNativeBtn" title="Hızlı Sesli" aria-label="Hızlı sesli modu başlat" class="btn-voice btn-voice-native">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>
                </button>
                @if (_isStreaming)
                {
                    <button id="stopBtn" type="button" title="Yanıtı durdur" aria-label="Yanıtı durdur" class="btn-stop-stream" @onclick="StopStreamAsync">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                            <rect x="6" y="6" width="12" height="12" rx="2"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button id="sendBtn" title="Gönder" aria-label="Mesaj gönder" @onclick="HandleSendAsync">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18.168-8.215a.5.5 0 0 0 0-.904z"/>
                            <path d="M6 12h16"/>
                        </svg>
                    </button>
                }
            </div>
            <div id="voiceStatus" class="voice-status" hidden="">
                <span class="voice-pulse"></span>
