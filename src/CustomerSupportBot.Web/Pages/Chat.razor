    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
        => _customerName = (await TokenStore.ReadAsync(AuthScope.Customer))?.FullName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await ThemeSvc.EnsureInitAsync();
        ThemeSvc.OnChange += StateHasChanged;
        StateHasChanged();

        _dotNetRef = DotNetObjectReference.Create(this);
        _apiBase   = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        // chat-bridge.js ham fetch/EventSource kullanıyor (Blazor HttpClient'in Authorization
        // header'ı otomatik eklediği pipeline'ın dışında) — token'ı JS tarafına elle taşıyoruz.
        var authToken = await TokenStore.GetAccessTokenAsync(AuthScope.Customer);
        await JS.InvokeVoidAsync("loadScript", "/js/chat-bridge.js", "js-chat-bridge");
        await JS.InvokeVoidAsync("__chatSetup", _dotNetRef, _apiBase, authToken);

        await JS.InvokeVoidAsync("loadScript", "/js/realtime-client.js", "js-realtime-client");
        await JS.InvokeVoidAsync("loadScript", "/js/realtime-ui.js", "js-realtime-ui");
    }

    private async Task ToggleThemeAsync() => await ThemeSvc.ToggleAsync();

    // ── Send ──────────────────────────────────────────────────────────────────
    private async Task HandleSendAsync()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text) || _isStreaming) return;
        _input = string.Empty;
        await SendAsync(text);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await HandleSendAsync();
    }

    /// <summary>
    /// Hazır metinli düğmelerden (karşılama çipleri, kategori kartları) mesaj gönderir.
