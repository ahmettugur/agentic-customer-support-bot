    private async Task SendAsync(string text)
    {
        ClearRatingDelayTimer();
        _messages.Add(new ChatMsg { Role = "user", Content = text });
        if (!_humanMode)
        {
            _currentBot = new ChatMsg { Role = "assistant", IsStreaming = true };
            _messages.Add(_currentBot);
        }
        ClearAgentChips();
        _isStreaming = true;
        StateHasChanged();
        await ScrollBottomAsync();
        // Streaming is handled by JS fetch → OnStreamEvent / OnStreamComplete / OnStreamError callbacks
        await JS.InvokeVoidAsync("__streamChat", _dotNetRef, _apiBase, text, _sessionId, false);
    }

    /// <summary>
    /// JS'in ham fetch ile aldığı 401'i bildirir (bkz. __streamChat). Bu, Blazor'un normal
    /// HttpClient'ı için var olan <see cref="AuthorizedHttpClientHandler"/>'ın 401→refresh→retry
    /// mantığının chat-stream fetch'i için karşılığıdır — o handler burada devrede değil çünkü
    /// chat-bridge.js kendi ham fetch/EventSource'unu kullanıyor.
    /// </summary>
    [JSInvokable]
    public async Task OnStreamUnauthorized(string query, string? sessionId)
    {
        var refreshed = await AuthSvc.TryRefreshAsync(AuthScope.Customer);
        if (refreshed is null)
        {
            AuthState.NotifyStateChanged();
            OnStreamError("oturum süresi doldu");
            var returnTo = Uri.EscapeDataString(Nav.Uri);
            Nav.NavigateTo($"/customer-login?return={returnTo}", forceLoad: false);
            return;
        }

        await JS.InvokeVoidAsync("__setAuthToken", refreshed.AccessToken);
        // isRetry=true — bu deneme de 401 alırsa JS doğrudan OnStreamError'a düşer,
        // ikinci bir refresh denemesi yapılmaz.
        await JS.InvokeVoidAsync("__streamChat", _dotNetRef, _apiBase, query, sessionId, true);
    }

    /// <summary>
    /// Kalıcı bildirim kanalının (EventSource) bir hatası — muhtemelen süresi dolmuş token.
    /// EventSource tarayıcı API'sinde HTTP status kodu görünmediği için ayrım yapılamaz;
    /// bu yüzden her hatada refresh denenir. chat-bridge.js bunu her bağlantı başına en
    /// fazla bir kez çağırır (bkz. _persistentEventsRetried), sonsuz döngü oluşmaz.
    /// </summary>
    [JSInvokable]
    public async Task OnPersistentEventsError(string sid)
    {
        var refreshed = await AuthSvc.TryRefreshAsync(AuthScope.Customer);
        if (refreshed is null)
        {
            AuthState.NotifyStateChanged();
            var returnTo = Uri.EscapeDataString(Nav.Uri);
            Nav.NavigateTo($"/customer-login?return={returnTo}", forceLoad: false);
            return;
        }

        await JS.InvokeVoidAsync("__setAuthToken", refreshed.AccessToken);
        await JS.InvokeVoidAsync("_startPersistentEvents", sid, true);
    }

    [JSInvokable]
    public void OnStreamEvent(string type, string data)
    {
        if (_currentBot is null) return;
        JsonElement jd;
        try { jd = JsonSerializer.Deserialize<JsonElement>(data.Length > 0 ? data : "{}"); }
        catch { jd = default; }

        switch (type)
        {
            case "session":
                if (jd.TryGetProperty("sessionId", out var sid))
                {
                    var s = sid.GetString();
                    if (s is not null && s != _sessionId)
                    {
                        _sessionId = s;
                        _ = JS.InvokeVoidAsync("_startPersistentEvents", s).AsTask();
                        _ = FetchUnseenApprovalsAsync(s);
                    }
                }
                break;
            case "done":
                if (_sessionId is null && jd.TryGetProperty("sessionId", out var sid2))
                {
                    var s2 = sid2.GetString();
                    if (s2 is not null)
                    {
                        _sessionId = s2;
                        _ = JS.InvokeVoidAsync("_startPersistentEvents", s2).AsTask();
                        _ = FetchUnseenApprovalsAsync(s2);
                    }
                }
                break;
            case "reasoning_start":
                if (_currentBot is not null) _currentBot.ReasoningText = "";
                break;
            case "reasoning_delta":
                if (jd.TryGetProperty("text", out var rd)) _currentBot.ReasoningText += rd.GetString() ?? "";
                break;
            case "reasoning_complete":
                _currentBot.ReasoningData = jd;
                if (jd.TryGetProperty("analysis", out var rc)) _currentBot.ReasoningText = rc.GetString() ?? _currentBot.ReasoningText;
                break;
            case "agent":
                {
                    var name   = jd.TryGetProperty("name",   out var an) ? an.GetString() : null;
                    var status = jd.TryGetProperty("status", out var as_) ? as_.GetString() : null;
                    UpsertAgentChip(name, status);
                }
                break;
            case "response_start":
                // Yanıt akmaya başlamadan önce o ana kadarki çip listesini mesaja
                // kalıcı olarak kopyala — canlı çipler temizlense de "hangi ajanlar
                // çalıştı" bilgisi mesajın altında görünmeye devam etsin.
                _currentBot.ProcessedAgents = _agentChips
                    .OrderBy(c => c.SortOrder)
                    .Select(c => FriendlyAgentName(c.Name))
                    .Distinct()
                    .ToList();
                SealAgentChips();
                break;
            case "response_delta":
                if (jd.TryGetProperty("text", out var delta)) _currentBot.Content += delta.GetString() ?? "";
                break;
            case "response_complete":
                if (jd.TryGetProperty("text", out var full)) _currentBot.Content = full.GetString() ?? _currentBot.Content;
                _currentBot.IsStreaming = false;
                SealAgentChips();
                break;
            case "human_joined":
                // Bot yanıtı streaming sırasında admin devralırsa bot balonunu kaldır
                if (_currentBot is not null)
                {
                    _messages.Remove(_currentBot);
                    _currentBot = null;
                }
                _humanMode  = true;
                _humanAgent = jd.TryGetProperty("humanAgent", out var haj) ? haj.GetString() : "temsilci";
                ClearPendingHandoffTimer();
                _pendingHandoff = false;
                break;
            case "ui_hint":
                // Backend, hint'i ürettiği anki ambient ajanla etiketler (bkz. UiHintEmitter).
                // Bu, hint kuyruğa girip gecikmeli tüketildiğinde (ör. paralel alt görevler)
                // ekrandaki ajan çipinin yanlış (o an aktif olan başka) ajanı göstermesini önler.
                // Ajan zaten çip listesinde varsa durumuna dokunulmaz — sadece daha önce hiç
                // görülmemişse (running) eklenir.
                if (jd.TryGetProperty("agent", out var hintAgent) && hintAgent.ValueKind == JsonValueKind.String)
                {
                    var hintAgentName = hintAgent.GetString();
                    if (!string.IsNullOrEmpty(hintAgentName) && !_agentChips.Any(c => c.Name == hintAgentName))
                        UpsertAgentChip(hintAgentName, "running");
                }
                if (_currentBot is not null
                    && jd.TryGetProperty("kind", out var hintKind)
                    && hintKind.GetString() == "category_picker"
                    && jd.TryGetProperty("categories", out var cats)
                    && cats.ValueKind == JsonValueKind.Array)
                {
                    _currentBot.CategoryPicker = cats.EnumerateArray()
                        .Select(c => c.GetString() ?? "")
                        .Where(c => c.Length > 0)
                        .ToList();
                }
                break;
            case "error":
                _currentBot.Content    = jd.TryGetProperty("message", out var err) ? err.GetString() ?? "Hata oluştu." : "Hata oluştu.";
                _currentBot.IsStreaming = false;
                break;
        }

        if (type is "response_delta" or "reasoning_delta")
        {
            // Token başına ayrı StateHasChanged + JS interop scroll yerine kısa bir
            // pencerede (60ms) toplayıp tek render + tek scroll yap — hızlı streaming
            // sırasında her karakter için tam Blazor render döngüsü + JS geçişi
            // hissedilir bir yavaşlık yaratıyordu.
            ScheduleCoalescedRender();
        }
        else
        {
            CancelCoalescedRender();
            StateHasChanged();
            if (type is "response_complete" or "reasoning_complete")
                _ = ScrollBottomAsync();
        }
    }

    [JSInvokable]
    public void OnStreamComplete()
    {
        ClearRatingDelayTimer();
        if (_currentBot is not null) _currentBot.IsStreaming = false;
        _isStreaming = false;
        _currentBot  = null;
        var userMsgCount = _messages.Count(m => m.Role == "user");
        if (userMsgCount >= 2 && !_showRating && !_ratingSubmitted && !_humanMode)
        {
            _showRating = true;
            StartRatingAutoHideTimer();
        }
        StateHasChanged();
        _ = ScrollBottomAsync();
    }

    [JSInvokable]
    public void OnStreamError(string msg)
    {
        if (_currentBot is not null)
        {
            if (string.IsNullOrEmpty(_currentBot.Content))
                _currentBot.Content = $"Bağlantı hatası: {msg}";
            _currentBot.IsStreaming = false;
        }
        _isStreaming = false;
        _currentBot  = null;
        StateHasChanged();
        _ = ScrollBottomAsync();
    }

    private async Task SetSessionAsync(string? id)
    {
        if (id is null || id == _sessionId) return;
        _sessionId = id;
        try { await JS.InvokeVoidAsync("_startPersistentEvents", id); } catch { }
        _ = FetchUnseenApprovalsAsync(id);
    }

    /// <summary>
    /// Bloklamayan onay modelinde admin kararı, kullanıcı bağlı değilken de gelebilir —
    /// session id her belirlendiğinde (yeni sohbet, sayfa yenileme sonrası vb.) kaçırılan
    /// onay sonuçlarını çeker ve badge'i doldurur.
    /// </summary>
    private async Task FetchUnseenApprovalsAsync(string sessionId)
    {
        var unseen = await ChatApi.GetUnseenApprovalsAsync(sessionId);
        if (unseen.Count == 0) return;

        foreach (var a in unseen)
            if (_approvalNotifications.All(x => x.Id != a.Id))
                _approvalNotifications.Add(a);

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleApprovalPanelAsync()
    {
        _showApprovalPanel = !_showApprovalPanel;
        if (!_showApprovalPanel) return;

        // Panel açılınca hepsini "görüldü" işaretle — badge sayacı sıfırlanır.
        var toMark = _approvalNotifications.ToList();
        _approvalNotifications.Clear();
        StateHasChanged();

        foreach (var a in toMark)
            if (_sessionId is not null)
                await ChatApi.MarkApprovalSeenAsync(_sessionId, a.Id);

        // Panelde göstermeye devam etmek için ayrı bir "son görülenler" listesi tutuyoruz.
        _lastSeenApprovals = toMark;
    }

    /// <summary>
    /// Kalıcı "geçmiş işlemlerim" görünümü — unseen/lastSeen listesinin aksine görüldükten
    /// sonra da kaybolmaz, sayfa yenilendiğinde tekrar çekilir. İlk açılışta bir kez yüklenir,
    /// sonraki togglelarda tekrar fetch edilmez (panel kapatılıp açıldığında cache'ten gösterilir).
    /// </summary>
    private async Task ToggleFullHistoryAsync()
    {
        _showFullHistory = true;
        if (_historyLoaded) return;

        _historyLoading = true;
        StateHasChanged();

        _approvalHistory = await ChatApi.GetApprovalHistoryAsync();
        _historyLoading = false;
        _historyLoaded = true;
        StateHasChanged();
    }

    private static string ApprovalStatusLabel(string status) => status switch
    {
        "approved" => "✅ Onaylandı",
        "rejected" => "❌ Reddedildi",
        "pending"  => "⏳ Onay bekliyor",
        _          => "⏱️ Süresi doldu"
    };

    // ── Persistent events (admin live takeover) ───────────────────────────────
    [JSInvokable]
    public async Task OnPersistentEvent(string type, string data)
    {
        JsonElement jd;
        try { jd = JsonSerializer.Deserialize<JsonElement>(data); }
        catch { jd = default; }

        switch (type)
        {
            case "handoff_pending":
                _pendingHandoff = true;
                _pendingHandoffReason = jd.TryGetProperty("reason", out var pr) ? pr.GetString() : null;
                StartPendingHandoffTimer();
                break;
            case "handoff_cleared":
                ClearPendingHandoffTimer();
                _pendingHandoff = false;
                _pendingHandoffReason = null;
                _messages.Add(new ChatMsg
                {
                    Role    = "system",
                    Content = "ℹ️ Talebiniz kapatıldı. Şu anda size bağlanabilecek bir temsilci bulunamadı; dilerseniz yeniden yazabilirsiniz."
                });
                break;
            case "human_joined":
                ClearPendingHandoffTimer();
                _pendingHandoff = false;
                _humanMode  = true;
                _humanAgent = jd.TryGetProperty("humanAgent", out var ha) ? ha.GetString() : "temsilci";
                _messages.Add(new ChatMsg { Role = "system", Content = $"💬 Temsilci {_humanAgent} sohbete katıldı." });
                try { await JS.InvokeVoidAsync("__stopVoice"); } catch { }
                break;
            case "human_left":
                _humanMode  = false;
                _humanAgent = null;
                _messages.Add(new ChatMsg { Role = "system", Content = "ℹ️ Sohbet bot moduna döndü." });
                if (_messages.Count(m => m.Role == "user") >= 2 && !_ratingSubmitted)
                    StartRatingDelayTimer();
                break;
            case "bot_typing":
                var typingOn = jd.TryGetProperty("on", out var on) && on.GetBoolean();
                _showTypingIndicator = typingOn;
                _botTyping           = typingOn;
                break;
            case "human_message":
                _showTypingIndicator = false;
                var msgText = jd.TryGetProperty("text", out var t) ? t.GetString() ?? "" : "";
                var from    = jd.TryGetProperty("from", out var f) ? f.GetString() : "admin";
                if (from == "system")
                    _messages.Add(new ChatMsg { Role = "system", Content = msgText });
                else if (from == "bot")
                    _messages.Add(new ChatMsg { Role = "assistant", Content = msgText });
                else
                    _messages.Add(new ChatMsg { Role = "human", Content = msgText });
                break;
            case "approval_resolved":
                var approval = new UnseenApproval(
                    Id: jd.TryGetProperty("id", out var aid) ? aid.GetString() ?? "" : "",
                    ToolName: "",
                    Status: jd.TryGetProperty("status", out var ast) ? ast.GetString() ?? "" : "",
                    DecisionReason: jd.TryGetProperty("reason", out var ar) ? ar.GetString() : null,
                    ExecutionResult: jd.TryGetProperty("executionResult", out var aer) ? aer.GetString() : null,
                    DecidedAt: DateTimeOffset.UtcNow);
                if (_approvalNotifications.All(x => x.Id != approval.Id))
                    _approvalNotifications.Add(approval);
                break;
        }

        await InvokeAsync(StateHasChanged);
        if (type is "human_joined" or "human_left" or "human_message")
            await InvokeAsync(ScrollBottomAsync);
    }

    // ── New chat ──────────────────────────────────────────────────────────────
    private async Task NewChatAsync()
    {
        try { await JS.InvokeVoidAsync("__stopStream"); } catch { }
        try { await JS.InvokeVoidAsync("_stopPersistentEvents"); } catch { }
        _messages.Clear();
        _sessionId           = null;
        _input               = string.Empty;
        _isStreaming         = false;
        _botTyping           = false;
        _humanMode           = false;
        _humanAgent          = null;
        _showTypingIndicator = false;
        _showRating          = false;
        _selectedRating      = null;
        _ratingFeedback      = string.Empty;
        _ratingSubmitted     = false;
        ClearRatingAutoHideTimer();
        CancelCoalescedRender();
        ClearAgentChips();
        ClearPendingHandoffTimer();
        ClearRatingDelayTimer();
        _pendingHandoff      = false;
        _pendingHandoffReason = null;
    }

    // ── Rating ────────────────────────────────────────────────────────────────
    private async Task SubmitRatingAsync()
    {
        if (_sessionId is null || !_selectedRating.HasValue) return;
        _showRating      = false;
        _ratingSubmitted = true;
        await ChatApi.SubmitRatingAsync(_sessionId, _selectedRating.Value, _ratingFeedback);
        _messages.Add(new ChatMsg { Role = "system", Content = "⭐ Değerlendirmeniz alındı. Teşekkürler!" });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private void StartPendingHandoffTimer()
    {
        ClearPendingHandoffTimer();
        _pendingHandoffTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(() =>
                {
                    if (!_pendingHandoff || _humanMode) return;
                    _messages.Add(new ChatMsg
                    {
                        Role    = "system",
                        Content = "⏳ Temsilcimiz hâlâ müsait değil. Beklemeye devam edebilir veya daha sonra yeniden yazabilirsiniz."
                    });
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException) { }
            catch (TaskCanceledException) { }
        }, null, TimeSpan.FromMinutes(2), System.Threading.Timeout.InfiniteTimeSpan);
    }

    private void ClearPendingHandoffTimer()
    {
        _pendingHandoffTimer?.Dispose();
        _pendingHandoffTimer = null;
    }

    /// <summary>
    /// Kullanıcı temsilci beklemekten vazgeçtiğinde çağrılır — sunucudaki eskalasyon
    /// kaydını kapatmaz (o admin'in elinde), sadece istemci tarafında input'u yeniden
    /// açar. Eğer bir temsilci daha sonra bağlanırsa "human_joined" event'i zaten
    /// _pendingHandoff'u tekrar false yapıp devralmayı normal şekilde gösterecektir.
    /// </summary>
    private void CancelPendingHandoff()
    {
        ClearPendingHandoffTimer();
        _pendingHandoff = false;
        _pendingHandoffReason = null;
        _messages.Add(new ChatMsg
        {
            Role    = "system",
            Content = "Beklemekten vazgeçtiniz. Sohbete devam edebilirsiniz; bir temsilci daha sonra bağlanırsa bilgilendirileceksiniz."
        });
    }

    private void StartRatingDelayTimer()
    {
        ClearRatingDelayTimer();
        _ratingDelayTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(() =>
                {
                    if (_isStreaming || _botTyping || _showRating || _ratingSubmitted) return;
                    if (_messages.Count(m => m.Role == "user") < 2) return;
                    _showRating = true;
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException) { }
            catch (TaskCanceledException) { }
        }, null, TimeSpan.FromSeconds(3), System.Threading.Timeout.InfiniteTimeSpan);
    }

    private void ClearRatingDelayTimer()
    {
        _ratingDelayTimer?.Dispose();
        _ratingDelayTimer = null;
    }

    private void StartRatingAutoHideTimer()
    {
        ClearRatingAutoHideTimer();
        _ratingAutoHideTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(() =>
                {
                    if (_selectedRating.HasValue) return;
                    _showRating = false;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(18), System.Threading.Timeout.InfiniteTimeSpan);
    }

    private void ClearRatingAutoHideTimer()
    {
        _ratingAutoHideTimer?.Dispose();
        _ratingAutoHideTimer = null;
    }

    // ── Ajan çip listesi ──────────────────────────────────────────────────────
    private void UpsertAgentChip(string? name, string? status)
    {
        if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(status)) return;
        // Yanıt akmaya başladıktan sonra gelen geç ajan olayları paneli yeniden AÇMAMALI.
        if (_agentChipsSealed) return;

        var existing = _agentChips.FirstOrDefault(c => c.Name == name);
        if (existing != null) existing.Status = status;
        else _agentChips.Add(new AgentChip { Name = name, Status = status, SortOrder = _agentChipSeq++ });
    }

    /// <summary>Tur başlangıcı — listeyi boşaltır ve yeni ajan çiplerine yeniden izin verir.</summary>
    private void ClearAgentChips()
    {
        _agentChips.Clear();
        _agentChipSeq = 0;
        _agentChipsSealed = false;
    }

    /// <summary>
    /// Yanıt akışı başladıktan sonra listeyi boşaltır ve YENİ çip eklenmesini kapatır.
    ///
    /// <para>
    /// Backend, ResponseAgent'ın <c>status=done</c> olayını ilk <c>response_delta</c>'dan SONRA
    /// gönderiyor: <c>ExecutorCompletedEvent</c>, <c>AgentResponseUpdateEvent</c>'ten sonra
    /// geliyor (bkz. WorkflowTraceEventProcessor). Bu olay engellenmezse <c>response_start</c>'ta
    /// temizlenen panel tek bir çiple yeniden açılıyor, ardından <c>response_complete</c>'te
    /// tekrar kapanıyordu — kullanıcı yanıt geldikten sonra bir "kapan-aç-kapan" titremesi
    /// görüyordu. Mühürleme bir sonraki turda <see cref="ClearAgentChips"/> ile kalkar.
    /// </para>
    /// </summary>
    private void SealAgentChips()
    {
        _agentChips.Clear();
        _agentChipSeq = 0;
        _agentChipsSealed = true;
    }

    // ── response_delta / reasoning_delta render coalescing ──────────────────────
    private void ScheduleCoalescedRender()
    {
        if (_coalescePending) return;
        _coalescePending = true;
        _coalesceTimer?.Dispose();
        _coalesceTimer = new System.Threading.Timer(async _ =>
        {
            _coalescePending = false;
            try
            {
                await InvokeAsync(StateHasChanged);
                await ScrollBottomAsync();
            }
            catch (ObjectDisposedException) { }
            catch (TaskCanceledException) { }
        }, null, TimeSpan.FromMilliseconds(60), System.Threading.Timeout.InfiniteTimeSpan);
    }

    private void CancelCoalescedRender()
    {
        _coalesceTimer?.Dispose();
        _coalesceTimer = null;
        _coalescePending = false;
    }

    private static string GetCategoryIcon(string category)
    {
        var lower = category.ToLowerInvariant();
        if (lower.Contains("elektronik") || lower.Contains("electronic") || lower.Contains("bilgisayar") || lower.Contains("computer")) return "💻";
        if (lower.Contains("telefon") || lower.Contains("phone") || lower.Contains("mobil") || lower.Contains("mobile")) return "📱";
        if (lower.Contains("giyim") || lower.Contains("clothes") || lower.Contains("kıyafet") || lower.Contains("tekstil")) return "👗";
        if (lower.Contains("kitap") || lower.Contains("book") || lower.Contains("yayın")) return "📚";
        if (lower.Contains("gıda") || lower.Contains("yiyecek") || lower.Contains("food") || lower.Contains("içecek") || lower.Contains("drink")) return "🛒";
        if (lower.Contains("spor") || lower.Contains("sport") || lower.Contains("fitness")) return "🏋️";
        if (lower.Contains("oyun") || lower.Contains("game") || lower.Contains("oyuncak") || lower.Contains("toy")) return "🎮";
        if (lower.Contains("ev") || lower.Contains("home") || lower.Contains("mobilya") || lower.Contains("furniture")) return "🏠";
        if (lower.Contains("güzellik") || lower.Contains("beauty") || lower.Contains("kozmetik") || lower.Contains("sağlık") || lower.Contains("health")) return "💄";
        if (lower.Contains("araç") || lower.Contains("oto") || lower.Contains("car") || lower.Contains("motor")) return "🚗";
        if (lower.Contains("müzik") || lower.Contains("music") || lower.Contains("ses") || lower.Contains("audio")) return "🎵";
        if (lower.Contains("fotoğraf") || lower.Contains("photo") || lower.Contains("kamera") || lower.Contains("camera")) return "📷";
        return "🏷️";
    }

    // Tek doğruluk kaynağı: agent adı → Türkçe etiket. Daha önce chat-bridge.js
    // (sesli mod) kendi kopyasını elle senkron tutuyordu ve HumanHandoffAgent case'i
    // eksikti — bu drift'i önlemek için JS artık bu sözlüğü GetAgentNameMap() ile
    // JSInterop üzerinden bir kez çekip cache'liyor (bkz. chat-bridge.js __chatSetup).
    private static readonly Dictionary<string, string> _agentNameMap = new()
    {
        ["PlanningAgent"]     = "Planlama Ajanı",
        ["ProductAgent"]      = "Ürün Ajanı",
        ["OrderAgent"]        = "Sipariş Ajanı",
        ["ComplaintAgent"]    = "Şikayet Ajanı",
        ["HumanHandoffAgent"] = "Müşteri Temsilcisi",
        ["ResponseAgent"]     = "Yanıt Ajanı",
        ["Orchestrator"]      = "Orkestratör",
    };

    private static string FriendlyAgentName(string id)
    {
        // Workflow executor id'leri "<AjanAdı>_<guid>" biçiminde gelir
        // (AIAgentExtensions.GetDescriptiveId) — eşleşme için guid soneki atılır.
        var baseName = id.Contains('_') ? id[..id.IndexOf('_')] : id;
        if (_agentNameMap.TryGetValue(baseName, out var friendly)) return friendly;
        return baseName.StartsWith("SubTask#") ? $"Alt Görev {baseName[8..]}" : baseName;
    }

    [JSInvokable]
    public static Task<Dictionary<string, string>> GetAgentNameMap() =>
        Task.FromResult(_agentNameMap);

    private async Task ScrollBottomAsync()
    {
        try { await JS.InvokeVoidAsync("__scrollToBottom", "messages"); }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        ThemeSvc.OnChange -= StateHasChanged;
        ClearPendingHandoffTimer();
        ClearRatingDelayTimer();
        ClearRatingAutoHideTimer();
        CancelCoalescedRender();
        try { await JS.InvokeVoidAsync("__stopStream"); } catch { }
        if (_dotNetRef is not null)
        {
            try { await JS.InvokeVoidAsync("_stopPersistentEvents"); } catch { }
            _dotNetRef.Dispose();
        }
    }
}
