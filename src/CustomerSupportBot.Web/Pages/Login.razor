@page "/login"
@layout EmptyLayout
@inject AuthService AuthSvc
@inject AppAuthStateProvider AuthState
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<link rel="stylesheet" href="css/login.css" />

@* Personel girişi: solda tanıtım alanı, sağda form. Stiller .staff-login altında (login.css) — müşteri
   girişi (CustomerLogin) aynı dosyanın eski sınıflarını kullanmaya devam eder. *@
<div class="staff-login">
    <section class="sl-brand" aria-hidden="true">
        <div class="sl-logo">
            <span class="sl-logo-mark"><Icon Name="message" Size="18" StrokeWidth="2" /></span>
            <span>Destek Konsolu</span>
        </div>
        <div class="sl-pitch">
            <h2>Asistanın karar veremediği yerde siz devreye girersiniz.</h2>
            <p>Onay bekleyen talepler, eskalasyonlar ve canlı sohbetler tek yerde.</p>
        </div>
        <span class="sl-foot">Yalnızca yönetici ve temsilci hesapları içindir.</span>
    </section>

    <section class="sl-form-side">
        <div class="sl-form-wrap">
            <div class="sl-heading">
                <h1>Giriş yap</h1>
                <p>Yönetici veya temsilci hesabınızla devam edin.</p>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="sl-error" role="alert" aria-live="polite">
                    <Icon Name="alert" Size="15" />
                    @_error
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLoginAsync" class="sl-form">
                <DataAnnotationsValidator />

                <label for="username">Kullanıcı adı</label>
                <InputText id="username" @bind-Value="_model.Username"
                           autocomplete="username" autofocus
                           aria-required="true" />

                <label for="password">Parola</label>
                <div class="sl-password">
                    <InputText id="password" type="@(_showPassword ? "text" : "password")"
                               @bind-Value="_model.Password"
                               autocomplete="current-password"
                               aria-required="true" />
                    <button type="button" class="sl-eye"
                            @onclick="() => _showPassword = !_showPassword"
                            aria-label="@(_showPassword ? "Parolayı gizle" : "Parolayı göster")"
                            title="@(_showPassword ? "Gizle" : "Göster")">
                        <Icon Name="@(_showPassword ? "eye-off" : "eye")" Size="18" />
                    </button>
                </div>

                <button type="submit" id="loginBtn" class="sl-submit" disabled="@_loading" aria-busy="@_loading">
                    @if (_loading)
                    {
                        <span class="login-spinner" aria-hidden="true"></span>
                    }
                    @(_loading ? "Giriş yapılıyor…" : "Giriş yap")
                </button>
            </EditForm>

            <p class="sl-alt">Müşteri misiniz? <a href="/customer-login">Müşteri girişi</a></p>
        </div>
    </section>
</div>

@code {
    private readonly LoginModel _model = new() { Username = "admin", Password = "Admin123!" };
    private string? _error;
    private bool _loading;
    private bool _showPassword;

    private string _returnUrl = "/admin";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var returnParam = query["return"];
        if (!string.IsNullOrWhiteSpace(returnParam))
            _returnUrl = returnParam;

        // Sadece staff rolüyle (Admin/Agent) authenticated ise geri yönlendir — aksi
        // halde (ör. localStorage'da kalmış bir Customer token'ı) admin sayfaları
        // yeniden reddedip buraya geri atar ve sonsuz döngü oluşur (bkz. CustomerLogin.razor).
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.IsInRole("Admin") || state.User.IsInRole("Agent"))
            Nav.NavigateTo(_returnUrl, forceLoad: false);
    }

    private async Task HandleLoginAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            await AuthSvc.LoginAsync(_model.Username, _model.Password);
            AuthState.NotifyStateChanged();
            Nav.NavigateTo(_returnUrl, forceLoad: false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
