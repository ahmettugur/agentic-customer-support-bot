<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api katmanına özgü paketler -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

  <!-- Knowledge Base markdown dosyalarını build çıktısına kopyala — KnowledgeBaseIngestor okur. -->
  <ItemGroup>
    <None Update="KnowledgeBase\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CustomerSupportBot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hexagonal Architecture: Domain + Application + Adapters -->
    <ProjectReference Include="..\CustomerSupportBot.Domain\CustomerSupportBot.Domain.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Application\CustomerSupportBot.Application.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Adapters.Persistence\CustomerSupportBot.Adapters.Persistence.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Adapters.Redis\CustomerSupportBot.Adapters.Redis.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Adapters.AI\CustomerSupportBot.Adapters.AI.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Adapters.Telemetry\CustomerSupportBot.Adapters.Telemetry.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Adapters.Agents\CustomerSupportBot.Adapters.Agents.csproj" />
  </ItemGroup>

  <!-- Prompt markdown dosyalarını build çıktısına kopyala.
         PromptService çalışma zamanında AppContext.BaseDirectory/Prompts altından okur. -->
  <ItemGroup>
    <None Update="Prompts\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
