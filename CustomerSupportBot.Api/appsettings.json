{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Persistence": {
    "Provider": "Postgres"
  },
  "Jwt": {
    "Issuer": "CustomerSupportBot",
    "Audience": "CustomerSupportBot",
    "SigningKey": "DEV_ONLY_REPLACE_IN_PRODUCTION_with_at_least_32_random_chars_!",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "DefaultAdminUsername": "",
    "DefaultAdminPassword": ""
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5433;Database=;Username=;Password=;Minimum Pool Size=10;Maximum Pool Size=100;Connection Lifetime=300;Connection Idle Lifetime=30",
    "Redis": "localhost:6380,abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Redis": {
    "KeyPrefix": "csbot",
    "DefaultLockTimeoutSeconds": 10,
    "LockExpirySeconds": 30
  },
  "AI": {
    "Provider": "OpenAI",
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-5.4",
      "ReasoningModel": "gpt-5.4-nano",
      "ReasoningEffort": "high"
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "Deployment": "gpt-5.4",
      "ReasoningDeployment": "gpt-5.4",
      "ReasoningEffort": "xhigh"
    },
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-haiku-4-5",
      "ReasoningModel": "claude-haiku-4-5",
      "MaxTokens": 4096
    },
    "Realtime": {
      "Enabled": true,
      "Model": "gpt-realtime-2",
      "ApiKey": "",
      "Voice": "marin",
      "VadSilenceMs": 800,
      "ReasoningEffort": "low",
      "MaxResponseTokens": 4096,
      "TranscriptionModel": "gpt-4o-transcribe",
      "TranscriptionLanguage": "tr",
      "TranscriptionPrompt": "Müşteri destek görüşmesi. Sipariş numarası (1030, 1042 gibi 4+ haneli rakam), müşteri numarası (1008, 1027 gibi 4+ haneli rakam), ürün adları (Coffee, Beer, Chocolate, Laptop, Smartphone gibi), kargo, iade, şikayet, sipariş durumu konuları geçer. Türkçe konuşulur."
    }
  },
  "SemanticMemory": {
    "Enabled": true,
    "VectorStore": {
      "Host": "localhost",
      "Port": 7334,
      "UseHttps": false,
      "ApiKey": ""
    },
    "Embedding": {
      "Model": "text-embedding-3-large",
      "Dimension": 3072
    },
    "Collections": {
      "Episodic": "cs_episodic",
      "Lessons": "cs_lessons",
      "Knowledge": "cs_knowledge"
    },
    "Retrieval": {
      "TopK": 4,
      "MinScore": 0.35,
      "MaxContextChars": 1800
    },
    "KnowledgeBase": {
      "AutoIngestOnStartup": true,
      "ChunkSize": 800,
      "ChunkOverlap": 100
    }
  },
  "SelfImprovement": {
    "Enabled": true,
    "MinRatingForLesson": 3,
    "RecentTracesToScan": 50,
    "MiningIntervalHours": 24,
    "RequireApprovalBeforeActivation": true
  },
  "WorkflowGuards": {
    "TimeoutSeconds": 180,
    "MaxDuplicateToolCalls": 3,
    "MaxTokensPerRequest": 30000,
    "MaxIterations": 20
  },
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "CustomerSupportBot",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc",
      "Headers": ""
    },
    "Pricing": {
      "default": {
        "InputPer1K": 0.00015,
        "OutputPer1K": 0.0006
      },
      "gpt-5.4": {
        "InputPer1K": 0.0025,
        "OutputPer1K": 0.01
      },
      "gpt-5.4-nano": {
        "InputPer1K": 0.00015,
        "OutputPer1K": 0.0006
      },
      "text-embedding-3-large": {
        "InputPer1K": 0.00013,
        "OutputPer1K": 0
      },
      "text-embedding-3-small": {
        "InputPer1K": 2e-05,
        "OutputPer1K": 0
      },
      "claude-haiku-4-5": {
        "InputPer1K": 0.001,
        "OutputPer1K": 0.005
      }
    }
  },
  "HumanInTheLoop": {
    "Enabled": true,
    "ToolsRequiringApproval": [
      "order_placement_tool",
      "order_cancel_tool",
      "return_request_tool",
      "complaint_registration_tool"
    ],
    "TimeoutSeconds": 60,
    "AutoApproveOnTimeout": false,
    "EscalationEnabled": true
  },
  "Routing": {
    "Enabled": true,
    "LoadBalancingEnabled": true,
    "LanguageWeight": 0.2,
    "MinMatchScore": 0.1,
    "IntentSkillMap": {
      "şikayet": [
        "complaint"
      ],
      "sipariş_oluşturma": [
        "order"
      ],
      "sipariş_sorgulama": [
        "order"
      ],
      "sipariş_listeleme": [
        "order"
      ],
      "sipariş_iptali": [
        "order"
      ],
      "iade_talebi": [
        "order",
        "refund"
      ],
      "ürün_bilgisi": [
        "product"
      ]
    },
    "ProfileKeywordSkillMap": {
      "VIP": "vip",
      "kurumsal": "enterprise"
    }
  },
  "ParallelExecution": {
    "Enabled": true,
    "MaxDegreeOfParallelism": 4
  },
  "Sla": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "Approvals": {
      "WarnAfterSeconds": 20,
      "BreachAfterSeconds": 45,
      "OnBreach": "AutoReject"
    },
    "Escalations": {
      "WarnAfterSeconds": 60,
      "BreachAfterSeconds": 180,
      "BoostPriorityOnBreach": true
    }
  }
}