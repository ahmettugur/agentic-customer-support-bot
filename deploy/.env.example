# deploy/docker-compose.yml için gizli değerler.
# Bu dosyayı deploy/.env olarak kopyalayıp değerleri doldurun; deploy/.env git'e girmez.
#   cp deploy/.env.example deploy/.env

# Postgres süper kullanıcı parolası. API'nin ConnectionStrings:Postgres değeriyle
# (user-secrets / ortam değişkeni) aynı olmalıdır.
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Langfuse — deploy/docker-compose.yml'deki langfuse-* servisleri ve otel-collector kullanır (zorunlu).
# Ayrıntı: docs/langfuse.md. Değerleri üretmek için:
#   openssl rand -hex 32      → LANGFUSE_ENCRYPTION_KEY (tam 64 hex karakter OLMALI)
#   openssl rand -base64 32   → SALT, NEXTAUTH_SECRET ve parolalar
# Langfuse, yukarıdaki POSTGRES_PASSWORD ile ana Postgres'teki ayrı "langfuse" veritabanını ve ana Redis'in
# 1 numaralı veritabanını kullanır; onlar için ayrı parola gerekmez.
# ---------------------------------------------------------------------------
LANGFUSE_ENCRYPTION_KEY=change-me-64-hex-chars
LANGFUSE_SALT=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me-min-8-chars

# Headless init: ilk açılışta bu anahtarlarla bir proje oluşturulur; OTel Collector Langfuse'a
# aynı anahtarlarla (Basic Auth) span gönderir. Önek zorunlu değil ama Langfuse biçimine uyar.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me

# Langfuse arayüzü girişi (http://localhost:3000)
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me

# Grafana (http://localhost:3001) — kullanıcı: admin
GRAFANA_ADMIN_PASSWORD=change-me
