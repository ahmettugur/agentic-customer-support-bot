<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CustomerSupportBot.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hexagonal: Domain modelleri ve Application port'ları -->
    <ProjectReference Include="..\CustomerSupportBot.Domain\CustomerSupportBot.Domain.csproj" />
    <ProjectReference Include="..\CustomerSupportBot.Application\CustomerSupportBot.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Agents Framework — grup sohbet workflow'u için -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.17.0" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.17.0" />
    <!-- LLM-as-judge kalite evaluator'ları (Relevance/Coherence) — MEAI 10.6.0 treniyle uyumlu (MAF 1.15.0'ın bağımlı olduğu sürüm) -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
  </ItemGroup>

</Project>
